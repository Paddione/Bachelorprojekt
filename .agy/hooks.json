{
    "PreToolUse": [
        {
            "matcher": "Write|Edit|NotebookEdit",
            "hooks": [
                {
                    "type": "command",
                    "command": "bash scripts/hooks/worktree-write-guard.sh",
                    "timeout": 5
                }
            ]
        }
    ],
    "SessionStart": [
        {
            "hooks": [
                {
                    "type": "command",
                    "command": "bash scripts/agent-lock.sh reap 2>/dev/null || true"
                },
                {
                    "type": "command",
                    "command": "codebase-memory-mcp hook-augment",
                    "timeout": 5,
                    "statusMessage": "Loading codebase-memory graph context..."
                }
            ]
        }
    ]
}
