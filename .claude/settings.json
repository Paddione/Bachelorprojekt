{
  "env": {
    "CHROME_WS_HOST": "127.0.0.1",
    "CHROME_WS_PORT": "9223",
    "TRACE_TO_BRAINTRUST": "true",
    "BRAINTRUST_API_URL": "https://api-eu.braintrust.dev",
    "BRAINTRUST_CC_PROJECT": "claude-code",
    "BRAINTRUST_CC_DEBUG": "true"
  },
  "permissions": {
    "allow": [
      "Bash(set -e)",
      "Bash(rm -f ~/.ssh/*:Zone.Identifier)",
      "Bash(chmod 700 ~/.ssh)",
      "Bash(chmod 600 ~/.ssh/id_ed25519 ~/.ssh/gekko_id_ed25519 ~/.ssh/config ~/.ssh/authorized_keys)",
      "Bash(chmod 644 ~/.ssh/id_ed25519.pub ~/.ssh/gekko_id_ed25519.pub)",
      "Bash(set +e)",
      "Bash(ssh -o ConnectTimeout=8 -o BatchMode=yes gekko-hetzner-2 'hostname; whoami; uname -r; sudo -n test true && echo SUDO_OK || echo SUDO_PROMPT')",
      "Bash(echo \"exit=$?\")",
      "Bash(ssh -o ConnectTimeout=8 -o BatchMode=yes gekko-hetzner-3 'hostname; whoami')",
      "Bash(ssh -o ConnectTimeout=8 -o BatchMode=yes pk-hetzner-4 'hostname; whoami; uname -r; sudo -n test true && echo SUDO_OK || echo SUDO_PROMPT')",
      "Bash(npm config *)",
      "Bash(sudo npm install -g pnpm)",
      "Bash(pnpm --version)",
      "Bash(kubectl --context mentolder get nodes -o wide)",
      "Bash(kubectl --context korczewski get nodes -o wide)",
      "Bash(curl -fsSL https://deb.nodesource.com/setup_22.x)",
      "Bash(sudo -E bash -)",
      "Bash(sudo apt-get install -y nodejs)",
      "Bash(npm --version)",
      "Bash(task --list)",
      "Bash(task env:validate ENV=korczewski)",
      "Bash(task -a)",
      "Bash(ss -ltn 'sport = :__TRACKED_VAR__')",
      "Bash(k3d cluster *)",
      "Bash(task -l)",
      "Bash(dpkg -S /usr/bin/task)",
      "Bash(task --version)",
      "Bash(task --help)",
      "Bash(gh pr *)",
      "Bash(python3 -c \"import sys,json; d=json.load\\(sys.stdin\\); [print\\(f\\\\\"#{p['number']:5} {p['state']:8} {p['headRefName']:45} {p['title']}\\\\\"\\) for p in sorted\\(d,key=lambda x:-x['number']\\)]\")",
      "Bash(gh search *)",
      "Bash(git log *)",
      "Bash(gh issue *)",
      "Bash(awk '/^ workspace:validate:|^ validate:|workspace:validate:/{f=1} f{print} f&&/^ [a-z].*:$/&&!/validate/{c++; if\\(c>1\\)exit}' Taskfile.yml)",
      "Bash(kubectl config *)",
      "Bash(timeout 25 kubectl --context fleet get ns flux-system)",
      "Bash(timeout 25 kubectl --context fleet get kustomizations.kustomize.toolkit.fluxcd.io -A)",
      "Bash(timeout 20 kubectl --context fleet get ns argocd)",
      "Bash(timeout 25 kubectl --context fleet get ns)",
      "Bash(git fetch *)",
      "Bash(git pull *)"
    ],
    "defaultMode": "auto"
  },
  "disabledMcpjsonServers": [
    "task-master-ai",
    "github-mcp"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-code-discovery-gate",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/worktree-write-guard.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/agent-lock.sh reap 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "/home/patrick/.local/bin/codebase-memory-mcp cli detect_changes '{\"project\": \"home-patrick-Bachelorprojekt\"}' 2>/dev/null | python3 -c \"\nimport sys, json\ntry:\n    data = json.load(sys.stdin)\n    count = data.get('changed_count', 0)\n    files = data.get('changed_files', [])\n    symbols = data.get('impacted_symbols', [])\n    if count > 0:\n        files_str = ', '.join(files[:10])\n        sym_note = f' ({len(symbols)} Symbole betroffen)' if symbols else ''\n        msg = f'CODEBASE-MEMORY GRAPH VERALTET: {count} Datei(en) seit letztem Index geaendert: {files_str}{sym_note}. Erwaege Re-Index (mode=fast) bevor du graph-Tools nutzt.'\n        print(json.dumps({'hookSpecificOutput': {'hookEventName': 'SessionStart', 'additionalContext': msg}}))\nexcept:\n    pass\n\" 2>/dev/null || true",
            "timeout": 30,
            "statusMessage": "Checking codebase-memory graph freshness..."
          }
        ]
      },
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "resume",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/cbm-session-reminder"
          }
        ]
      },
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "gh-axi",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "superpowers@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "code-review@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "playwright@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "feature-dev@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "ralph-loop@claude-plugins-official": false,
    "security-guidance@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": false,
    "plugin-dev@claude-plugins-official": false,
    "explanatory-output-style@claude-plugins-official": true,
    "playground@claude-plugins-official": false,
    "hookify@claude-plugins-official": true,
    "remember@claude-plugins-official": false,
    "huggingface-skills@claude-plugins-official": true,
    "mcp-server-dev@claude-plugins-official": true,
    "semgrep@claude-plugins-official": false,
    "postman@claude-plugins-official": false,
    "desktop-commander@claude-plugins-official": false,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "agent-sdk-dev@claude-plugins-official": false,
    "learning-output-style@claude-plugins-official": true,
    "superpowers-chrome@superpowers-marketplace": true,
    "superpowers-developing-for-claude-code@superpowers-marketplace": false,
    "superpowers-lab@superpowers-marketplace": false,
    "braintrust@braintrust-claude-plugin": false,
    "trace-claude-code@braintrust-claude-plugin": false,
    "brightdata-plugin@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "superpowers-marketplace": {
      "source": {
        "source": "github",
        "repo": "obra/superpowers-marketplace"
      }
    },
    "claude-video": {
      "source": {
        "source": "github",
        "repo": "bradautomates/claude-video"
      }
    },
    "braintrust-claude-plugin": {
      "source": {
        "source": "github",
        "repo": "braintrustdata/braintrust-claude-plugin"
      }
    }
  },
  "language": "German",
  "effortLevel": "medium",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "voiceEnabled": true
}
