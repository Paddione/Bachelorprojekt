# Exclude large directories not needed for Docker build
website/node_modules
mentolder-web/node_modules  # runtime: npm install
website/dist                # runtime: astro build
website/.env                # runtime: local env file
website/.env.*
!website/.env.example

# Exclude non-essential top-level dirs to keep build context lean
.git
.github
environments/.secrets
environments/sealed-secrets
environments/certs
prod
prod-mentolder
prod-korczewski
scripts
!scripts/knowledge
brett
docker
wireguard

# Exclude test artifacts that don't belong in the runtime image
tests/e2e/node_modules      # runtime: npm install
tests/e2e/test-results      # runtime: playwright test
tests/results               # runtime: test run
tests/unit/lib
