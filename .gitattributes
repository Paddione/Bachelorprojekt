# T016422: Windows-native Dev — Shell-/YAML-Sourcen strikt LF
*.sh    text eol=lf
*.bats  text eol=lf
# Linux-interpreted sources must stay LF — NTFS checkout (Windows-native dev,
# ADR-007) would otherwise introduce CRLF and break bash/yaml parsing.
*.yaml  text eol=lf
*.yml   text eol=lf
*.mjs   text eol=lf

# ── git-crypt-managed secrets (encrypted at rest in this PUBLIC repo) ──
# MUST come after *.yaml/*.yml text rules so the more-specific path pattern
# wins: the git-crypt blobs are binary, so text/eol normalization would
# corrupt them (T016422 quirk). -text keeps them stored verbatim.
environments/.secrets/**            filter=git-crypt diff=git-crypt -text

