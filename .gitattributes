brett/public/assets/sfx/*.ogg    binary
brett/public/assets/hud/*.png    binary
brett/public/assets/hud/*.svg    linguist-language=SVG
brett/public/assets/sprites/*.png binary
brett/public/assets/figure-pack/accessories/*.png binary
brett/public/assets/figure_pack_extension/accessories/*.png binary
brett/public/assets/game_assets_mentolder/hud/*.png binary
brett/public/assets/game_assets_mentolder/sprites/*.png binary

# ── Auto-generated artifacts — always resolve conflicts by keeping branch version ──
# These files are regenerated by CI after every merge to main (freshness-regen.yml).
# Using merge=ours prevents line-level conflict noise on local rebase/merge.
# Register the driver once per machine: git config merge.ours.driver true
# (also done by `task secrets:install-hooks`)
# Guard gegen Drift in diesem Block: tests/spec/ci-cd/generated-artifacts-registry.bats
# prueft per `git check-attr`, dass (a) jede vom freshness:check-Gate gepruefte
# Datei hier steht und (b) kein Eintrag auf einen nicht existierenden Pfad zeigt.
# Ein Eintrag mit falschem Pfad ist schlimmer als gar keiner: er sieht nach Schutz
# aus, waehrend die echte Datei ungeschuetzt bleibt (T002686).
docs/generated/**                             merge=ours linguist-generated=true
docs/code-quality/repo-index.json             merge=ours linguist-generated=true
k3d/docs-content-built/**                     merge=ours linguist-generated=true

# ── Freshness-checked generated JSON/data artifacts (all regenerated by task freshness:regenerate) ──
# Same merge=ours rationale: concurrent branches that both regenerate these will
# collide on rebase. Keeping the branch version is always safe since CI will
# regenerate the canonical artifact post-merge (<https://github.com/Paddione/Bachelorprojekt/actions/workflows/freshness-regen.yml>).
website/src/data/openspec-status.json         merge=ours linguist-generated=true
website/src/data/test-inventory.json          merge=ours linguist-generated=true
website/src/data/route-manifest.json          merge=ours linguist-generated=true
website/src/lib/learning-assets.generated.json merge=ours linguist-generated=true
website/src/lib/sdlc/goals-data.generated.json merge=ours linguist-generated=true
website/src/lib/agent-guide.generated.json    merge=ours linguist-generated=true
website/src/lib/platform-descriptions.generated.json merge=ours linguist-generated=true
website/public/learning-assets/THIRD-PARTY-ASSETS.md merge=ours linguist-generated=true
docs/agent-guide/10-ziele.md                  merge=ours linguist-generated=true
docs/agent-guide/20-werkzeuge.md              merge=ours linguist-generated=true
docs/agent-guide/30-bausteine.md              merge=ours linguist-generated=true
docs/agent-guide/maps/goals-map.md            merge=ours linguist-generated=true
docs/agent-guide/maps/tools-map.md            merge=ours linguist-generated=true
docs/agent-guide/maps/danger-map.md           merge=ours linguist-generated=true
docs/agent-guide/maps/agents-map.md           merge=ours linguist-generated=true
