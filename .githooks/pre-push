#!/usr/bin/env bash
# [T002471-M1] Graceful degradation wenn node_modules fehlt (frischer Worktree)
if [[ ! -f "$(git rev-parse --show-toplevel 2>/dev/null)/node_modules/.bin/madge" ]]; then
  echo "⚠ node_modules/madge not found — skipping quality:check (CI runs fail-closed)"
  echo "  Run 'npm install' in the repo root to enable local quality checks."
  exit 0
fi
# pre-push: fast quality gate (blockierend) + Conventional-Commit-Gate (blockierend)
#            + BATS-Konsistenz-Advisory (warn-only) + Branch/PR naming advisory.
#
# Blockierend (exit 1):
#   task quality:check (S1-S4 Ratchet, ~3s)
#   scripts/validate-commit-msg.sh (Conventional-Commit-Header aller gepushten, nicht-main Commits) [T001356]
#   Bypass: SKIP_CI_CHECK=1 git push
#
# Advisory (exit 0, nur Warnung):
#   BATS-Dateien geändert aber repo-index.json/test-inventory.json fehlen im Push
#   Branch-Name ohne Ticket-ID (PR muss [T000XXX] enthalten) [T002093]
set -uo pipefail

repo_root="$(git rev-parse --show-toplevel)"

warn() { printf '⚠  pre-push: %s\n' "$*" >&2; }
err()  { printf '✗  pre-push: %s\n' "$*" >&2; }

# ── 1. Blocking quality gate ──────────────────────────────────────────────────
if [[ "${SKIP_CI_CHECK:-0}" == "1" ]]; then
  warn "SKIP_CI_CHECK=1 — quality:check bypassed"
else
  if ! task quality:check; then
    err "quality:check failed — push blocked"
    err "Fix the violations above, then push again."
    err "To bypass (emergency only): SKIP_CI_CHECK=1 git push"
    exit 1
  fi
fi

# ── 2. Blocking: Conventional Commit validation [T001356 / G-GIT02] +
#      Advisory: BATS changed without repo-index/test-inventory update ───────
REMOTE="$1"
URL="$2"
_commit_msg_failed=0
while IFS=' ' read -r LOCAL_REF LOCAL_SHA REMOTE_REF REMOTE_SHA; do
  [[ "$LOCAL_SHA" == "0000000000000000000000000000000000000000" ]] && continue
  # Immer gegen origin/main validieren, nicht gegen den alten Remote-Branch-Tip
  # (REMOTE_SHA): nach einem `git rebase origin/main` (der in git-workflow als
  # Standardweg fuer CONFLICTING-PRs dokumentiert ist) liegt REMOTE_SHA nicht
  # mehr auf der Ahnenlinie des neuen HEAD - "REMOTE_SHA..LOCAL_SHA" zieht dann
  # bereits gemergte main-Commits mit rein (die eigene, laengst validierte
  # Historie) und blockt den Push mit fremden Commit-Messages [T002104-Folgebefund].
  BASE=$(git rev-parse --verify "origin/main" 2>/dev/null || echo "${REMOTE_SHA:-}")
  if [[ -z "$BASE" || "$BASE" == "0000000000000000000000000000000000000000" ]]; then
    BASE=$(git rev-parse --verify "HEAD~1" 2>/dev/null || true)
  fi
  [[ -z "$BASE" ]] && continue

  if [[ "${SKIP_CI_CHECK:-0}" != "1" ]]; then
    if ! "$repo_root/scripts/validate-commit-msg.sh" range "${BASE}..${LOCAL_SHA}"; then
      _commit_msg_failed=1
    fi
  fi

  # ── Empty-branch guard [T002240] ────────────────────────────────────────────
  # Mishap 2026-07-26 (x2): `git commit` and `git push` on separate lines of one
  # shell block. A pre-commit/commit-msg gate rejected the commit, the push ran
  # anyway, and a branch pointing at the same commit as main landed on origin:
  #     ✗ unknown scope 'agents': …
  #      * [new branch]  fix/T002221-agent-tools-frontmatter -> …
  # A PR opened from such a branch is empty and its CI is green.
  # Blocking only for the unambiguous accident — a BRAND-NEW remote branch
  # (REMOTE_SHA all-zeros) with zero commits ahead of origin/main. That
  # combination has no legitimate use. An already-existing remote branch that
  # happens to be fully merged only gets a warning, and a new branch that does
  # carry commits pushes normally.
  # Bypass (emergency only): SKIP_EMPTY_BRANCH_CHECK=1 git push
  if [[ "${SKIP_EMPTY_BRANCH_CHECK:-0}" != "1" && "${SKIP_CI_CHECK:-0}" != "1" ]]; then
    _ahead=""
    if git rev-parse --verify --quiet origin/main >/dev/null 2>&1; then
      _ahead=$(git rev-list --count "origin/main..$LOCAL_SHA" 2>/dev/null || echo "")
    fi
    case "$REMOTE_REF" in refs/heads/main|refs/heads/develop|refs/tags/*) _ahead="" ;; esac
    if [[ "$_ahead" == "0" ]]; then
      if [[ "${REMOTE_SHA:-}" == "0000000000000000000000000000000000000000" ]]; then
        err "refusing to create '$REMOTE_REF' — it has no commits ahead of origin/main."
        err "This is the signature of a rejected commit followed by an unchained push:"
        err "  the branch would land empty and any PR from it would be a no-op."
        err "Check with: git log --oneline -1   (did your commit actually happen?)"
        err "Then chain them: git commit -m '…' && git push -u origin <branch>"
        err "To bypass (emergency only): SKIP_EMPTY_BRANCH_CHECK=1 git push"
        exit 1
      else
        warn "'$REMOTE_REF' has no commits ahead of origin/main — nothing new is being pushed."
      fi
    fi
  fi

  CHANGED_BATS=$(git diff --name-only "$BASE..$LOCAL_SHA" 2>/dev/null | grep '\.bats$' || true)
  [[ -z "$CHANGED_BATS" ]] && continue

  CHANGED_INDEX=$(git diff --name-only "$BASE..$LOCAL_SHA" 2>/dev/null | grep 'repo-index\.json\|test-inventory\.json' || true)
  if [[ -z "$CHANGED_INDEX" ]]; then
    # Only warn if freshness:regenerate would actually produce a diff
    _freshness_diff=""
    if command -v task &>/dev/null; then
      _freshness_diff=$(cd "$repo_root" && task freshness:regenerate --quiet 2>/dev/null && git diff --stat -- docs/code-quality/repo-index.json website/src/data/test-inventory.json 2>/dev/null || true)
    fi
    if [[ -n "$_freshness_diff" ]]; then
      warn "BATS-Dateien geändert, aber repo-index.json/test-inventory.json fehlen im Push."
      warn "CI schlägt möglicherweise fehl. Fix:"
      warn "  task freshness:regenerate"
      warn "  git add docs/code-quality/repo-index.json website/src/data/test-inventory.json"
      warn "  git commit --amend --no-edit && git push --force-with-lease"
    fi
  fi
done

if [[ "${SKIP_CI_CHECK:-0}" == "1" ]]; then
  warn "SKIP_CI_CHECK=1 — commit-message validation bypassed"
elif [[ "$_commit_msg_failed" -ne 0 ]]; then
  err "Conventional Commit validation failed — push blocked"
  err "Fix the commit message(s) above (git commit --amend / rebase -i), then push again."
  err "To bypass (emergency only): SKIP_CI_CHECK=1 git push"
  exit 1
fi

# ── 3. Advisory: Branch + PR naming convention [T002093] ────────────────────
# Warn if branch doesn't follow type/slug-T000XXX — PR title MUST include [T000XXX].
# This is advisory (not blocking) because the pre-commit hook already enforces branch naming.
_push_branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
if [[ -n "$_push_branch" && "$_push_branch" != "main" && "$_push_branch" != "develop" ]]; then
  case "$_push_branch" in
    release-please--*|dependabot/*|renovate/*) ;;
    *)
      if [[ ! "$_push_branch" =~ T[0-9]{6,} ]]; then
        warn "Branch '$_push_branch' has no ticket ID — PR title MUST include [T000XXX]."
        warn "Format: <type>(<scope>): <description> [T000XXX]"
        warn "Example: feat(flux): implement ArtifactGenerator [T002093]"
      fi
      ;;
  esac
fi

exit 0
