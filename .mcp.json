{
  "mcpServers": {
    "bge-mcp": {
      "type": "http",
      "url": "http://localhost:13005/mcp",
      "headers": {
        "Authorization": "Bearer ${BGE_MCP_TOKEN}"
      }
    },
    "codebase-memory-mcp": {
      "command": "/home/patrick/.local/bin/codebase-memory-mcp"
    },
    "factory-mcp": {
      "type": "http",
      "url": "http://localhost:13003/mcp"
    },
    "mcp-kubernetes": {
      "type": "http",
      "url": "http://localhost:18080/mcp"
    },
    "mcp-postgres": {
      "type": "http",
      "url": "http://localhost:13001/mcp"
    },
    "mcp-task-runner": {
      "command": "mcp-task-runner",
      "args": [
        "--otel-endpoint",
        "localhost:4317",
        "--taskfile",
        "/home/patrick/Bachelorprojekt/Taskfile.yml"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "ticket-mcp": {
      "command": "ticket-mcp-go"
    }
  }
}
