{
  "mcpServers": {
    "brain-mcp-node": {
      "command": "node",
      "args": [
        "scripts/brain-mcp-node/server.mjs"
      ],
      "env": {
        "BRAIN_WIKI_DIR": "~/brain/wiki"
      }
    },
    "codebase-memory-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "codebase-memory-mcp@0.10.8"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.1.1"
      ]
    },
    "mcp-kubernetes": {
      "type": "http",
      "url": "http://localhost:18080/mcp"
    },
    "mcp-task-runner": {
      "command": "node",
      "args": [
        "scripts/mcp-task-runner/server.mjs",
        "--otel-endpoint",
        "localhost:4317",
        "--taskfile",
        "Taskfile.yml"
      ]
    },
    "playwright": {
      "command": "npx",
      "args": [
        "-y",
        "@playwright/mcp@latest"
      ]
    },
    "ticket-mcp-node": {
      "command": "node",
      "args": [
        "scripts/ticket-mcp-node/server.mjs"
      ]
    },
    "warden": {
      "command": "node",
      "args": [
        "scripts/warden-mcp/launch.mjs"
      ]
    }
  }
}
