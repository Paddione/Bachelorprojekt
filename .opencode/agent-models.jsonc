{
  "provider": {
    // Lokaler Provider direkt auf FreeToken-native (:1919) [T900208].
    //
    // Der Key heisst aus historischen Gruenden "llamacpp-local" (Modell-Strings
    // und opencode-Default referenzieren ihn) — dahinter steht seit
    // T014028/T014105 FreeToken-native (:1919, Qwen3.6-35B-A3B-NVFP4, statischer
    // 200k-KV-Pool). Kein llama.cpp-Loadout mehr aktiv.
    //
    // Direkt statt ueber den llm-proxy (:18235): der Proxy ist seit 2026-09-03
    // stillgelegt (ADR-007). FreeToken serviert single-flight
    // (--max-running-requests 1) aus einem statischen 200k-KV-Pool; weitere
    // Requests warten in FreeTokens eigener Queue. Die fruehere Proxy-Fallback-
    // Kette lokal -> deepseek -> zen [T002558] existiert damit nicht mehr —
    // Ausweichen auf deepseek ist eine explizite Agenten-Wahl.
    "llamacpp-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeToken direkt :1919 (Qwen3.6-35B-A3B-NVFP4, static 200k KV pool)",
      "options": {
        "baseURL": "http://127.0.0.1:1919/v1",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        // GEMESSEN 2026-09-16 (ft 0.1.2, Profil qwen-200k, static pool):
        // /v1/cache/status num_pages 200000 (= served KV!), moe_cache 4150
        // (40.5% resident). bench-freetoken-prefill.sh --tag static-200k:
        // decode ~100 tok/s, cold prefill ~2600-3700 tok/s wall, cached
        // (radix hit) ~12k-43k tok/s. Prefill-Pathologie (~7ms/tok, ft 0.1.1)
        // auf 0.1.2+--moe-prefill-hit-d2d geheilt. advertised max_model_len
        // 262144 ist NICHT die served KV. Reasoning default on -> kleines
        // max_tokens liefert leeren content (length) — Budget grosszuegig.
        // KV-Ladder-Alternative VERWORFEN: grosse MoE-Wachstums-Rebuilds OOMen
        // unter Fragmentierung (2.49GB-Alloc bei 1.93GB frei) — statisch gewinnt.
        "Qwen3.6-35B-A3B-NVFP4": {
          "name": "Qwen3.6-35B-A3B MoE (FreeToken :1919 direkt, static 200k KV / moe 4150, ~100 tok/s decode, reasoning on)",
          "limit": {
            "context": 200000,
            "output": 8192
          }
        }
      }
    },
    // OpenCode Zen/Go: "opencode-go" statt "opencode" (Zen) - Subscription-Tier
    // ($10/mo), deepseek-v4-flash ist Teil des Go-Katalogs (verifiziert per curl
    // gegen https://opencode.ai/zen/go/v1/chat/completions, cost:"0" = im Abo
    // enthalten).
    //
    // Kein "apiKey" hier [2026-08-03]: Der Schluessel liegt in
    // ~/.local/share/opencode/auth.json, wo `opencode auth login` ihn ablegt.
    // Ohne apiKey-Feld greift opencode genau dort zu.
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (Subscription)",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (OpenCode Go, 1M ctx, MoE 284B/13B active)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        // Der Go-Katalog fuehrt weit mehr (minimax-m3, kimi-k3, glm-5.2,
        // qwen3.8-max u.a.). Sie sind hier bewusst NICHT eingetragen — jeder
        // Eintrag will gemessen sein, bevor ein Agent darauf zeigt.
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (OpenCode Go, 1M ctx, maximale Reasoning-Tiefe)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    },
    // OpenCode Zen (https://opencode.ai/zen/v1) — der Katalog MIT `big-pickle`,
    // das auf dem Go-Katalog (/zen/go/v1) fehlt. Gleicher Auth-Schluessel wie
    // opencode-go (via `opencode auth` unter "opencode-zen" gehalten). big-pickle
    // laeuft im Free-Kontingent — bis das verbraucht ist, dann auf die
    // deepseek-Primaries wechseln.
    "opencode-zen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen (big-pickle, bis Free-Kontingent verbraucht)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle (OpenCode Zen, free tier — bis das Free-Kontingent verbraucht ist)",
          // messung: 2026-09-12 — Free-Quota-Korrektur: models.dev-Basis 256k, deklariert
          // 260000. 1.000.000 war Free-Quota-Wunschdenken; opencode nutzt die Zahl fuer
          // Auto-Compact (95%-Trigger) — ein zu hoher Wert reproduziert Overflow-Drops.
          "limit": {
            "context": 260000,
            "output": 16384
          }
        },
        // GEMESSEN [2026-08-22]: per GET /zen/v1/models gelistet UND per
        // chat/completions gegengeprueft (Antwort "OK", finish_reason=stop).
        // limit laut models.dev-Registry (opencode-Provider): 256k ctx,
        // 32k output, cost 0/0 — agentic coding model von Poolside,
        // tool_call=true.
        "laguna-s-2.1-free": {
          "name": "Laguna S 2.1 Free (OpenCode Zen, free tier, Poolside agentic coding model, models.dev: 256k ctx)",
          "limit": {
            "context": 256000,
            "output": 32000
          }
        }
      }
    },
    // Direkte DeepSeek-API als Ausweichweg, wenn OpenCode Go nicht traegt
    // (Abo-Limit, Zen-Ausfall). Key liegt in ~/.local/share/opencode/auth.json
    // unter dem Provider-Schluessel "deepseek" (via `opencode auth`).
    //
    // Beide V4-Modelle sind Reasoning-Modelle und fuellen reasoning_content
    // zusaetzlich zu content. Wer sie mit knappem max_tokens testet, sieht
    // content="" bei finish_reason="length" — das Budget ging fuers Denken
    // drauf und ist KEIN Fehler des Modells.
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (direkte API, Ausweichweg zu OpenCode Go)",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (direkte API)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (direkte API, maximale Reasoning-Tiefe)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    }
  },
  "agent": {
    // DER lokale Subagent (singular). 2026-09-16: die fuenf Familien-Handles
    // (gptoss/devstral/gemma/gemma12/qwen38) zeigten alle auf dasselbe
    // FreeToken-Modell — fuenf Namen, ein Slot, kein Prefix-Cache-Gewinn mehr
    // (ein Resident-Checkpoint, ein Radix-Cache). Kollabiert zu einem `local`.
    // Engine: --max-running-requests 1 (single-flight); FreeToken queuet weitere Requests
    // sequenzielle Dispatches, die ≤200k served KV teilen. Der Orchestrator
    // vergibt pro Dispatch budget_tokens (S ~32k / M ~80k / L ~150k).
    "local": {
      "description": "Sole local implementation subagent (Qwen3.6-35B-A3B MoE via FreeToken :1919 (direct), 200k served KV shared across queued dispatches). Text-only. Sequential dispatch with per-packet budget_tokens.",
      "mode": "subagent",
      "model": "llamacpp-local/Qwen3.6-35B-A3B-NVFP4",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#34D399",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    "reviewer": {
      "description": "Factory reviewer role — read, grep, glob, tests only; no edit/write/bash/task dispatch (Orchestrator applies edits). Write-capable: deny.",
      "mode": "subagent",
      "model": "llamacpp-local/Qwen3.6-35B-A3B-NVFP4",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#FBBF24",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "deny", "write": "deny", "bash": "deny", "task": "deny", "glob": "allow", "grep": "allow", "list": "allow", "read": "allow", "todowrite": "allow", "question": "allow", "skill": "allow", "lsp": "allow" }
    },
    // Eskalationsstufe NACH lokaler Kompaktierung/Retry und opencodes eigener
    // Kompaktierung. ZWEIGLEISIG (Go zuerst, direkte API als Fallback) —
    // die Alibaba-Drittschiene ist 2026-09-16 entfallen (2-Rail-Entscheidung).
    "deepseek-helper-go": {
      "description": "ESCALATION: DeepSeek V4 Flash via OpenCode Go (1M ctx) — FIRST escalation rail after local fails. Same role and prompt as deepseek-helper. Mode subagent: escalation-only, not tab-selectable.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F97316",
      "temperature": 0.3,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "deepseek-helper": {
      "description": "ESCALATION: DeepSeek V4 Flash via the direct DeepSeek API (1M ctx) — SECOND rail, dispatch when OpenCode Go is exhausted or rate-limited. Uses the direct API so it stays usable when the Go subscription is exhausted or Zen is down.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F97316",
      "temperature": 0.3,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Tiefe: DeepSeek V4 Pro mit maximaler Reasoning-Tiefe fuer komplexe
    // Architektur-Debugging, mehrschrittiges Reasoning und harte
    // Multi-File-Refactorings. EINER gleichzeitig — teure, langsame Stufe.
    "deepseek-pro": {
      "description": "DEPTH: DeepSeek V4 Pro via OpenCode Go (1M ctx, maximum reasoning effort). Use for deep analysis, complex multi-file debugging, architectural reasoning, or hard refactors that exceed what deepseek-flash can handle. Dispatch ONE at a time — this is the expensive, slow tier. If Go is unavailable, use deepseek-pro-direct. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#EF4444",
      "temperature": 0.1,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Ausweich-Zwilling von deepseek-pro auf der direkten API. opencode kennt
    // kein Provider-Failover pro Agent — ein zweiter Agentname ist der
    // einzige Weg, denselben Auftrag ueber den anderen Anbieter zu fahren.
    "deepseek-pro-direct": {
      "description": "FALLBACK twin of deepseek-pro on the direct DeepSeek API (1M ctx). Identical role and prompt — dispatch this instead of deepseek-pro when OpenCode Go is exhausted, rate-limited, or down. Not a second parallel slot: it is the same tier via another route. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#EF4444",
      "temperature": 0.1,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Durchsatz: DeepSeek V4 Flash, bis zu 3 Instanzen gleichzeitig (je 1M ctx).
    // Remote-Modelle konkurrieren nicht um die lokale GPU — der Default, wenn
    // lokal belegt ist. Breite, nicht Tiefe.
    "deepseek-flash": {
      "description": "THROUGHPUT: DeepSeek V4 Flash via OpenCode Go (1M ctx). Dispatch up to 3 at a time for independent parallel subtasks — each gets its own context window, and remote models do not contend for the single local GPU. Faster and cheaper than deepseek-pro; use for breadth, not depth. Default choice when no local model is loaded. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F59E0B",
      "temperature": 0.2,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "deepseek-flash-direct": {
      "description": "FALLBACK twin of deepseek-flash on the direct DeepSeek API (1M ctx). Same role and prompt — dispatch when OpenCode Go is exhausted, rate-limited, or down. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F59E0B",
      "temperature": 0.2,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "orchestrator": {
      "description": "Primary orchestrator: Laguna S 2.1 Free via OpenCode Zen (Poolside agentic coding model, free tier, 256k ctx per models.dev). Dispatches the single local subagent plus 2-rail cloud escalation (helper-go/helper, pro/pro-direct, flash/flash-direct). Also drives the factory executor (opencode-exec.sh runs --agent orchestrator). Tab-selectable via Tab key.",
      "mode": "primary",
      "model": "opencode-zen/laguna-s-2.1-free",
      "prompt": "{file:./prompts/orchestrator.md}",
      "color": "#8B5CF6",
      "temperature": 0.2,
      "steps": 150,
      // Exakte Namen statt Wildcards (Prinzip aus T002298): eine Wildcard
      // wuerde jeden neu hinzugefuegten Subagenten automatisch mitfreigeben.
      "permission": {
        "task": {
          "local": "allow",
          "deepseek-helper-go": "allow",
          "deepseek-helper": "allow",
          "deepseek-pro": "allow",
          "deepseek-pro-direct": "allow",
          "deepseek-flash": "allow",
          "deepseek-flash-direct": "allow",
          // T900074-p2: factory reviewer role must be dispatchable.
          "reviewer": "allow"
        }
      }
    },
    // Big Pickle auf OpenCode Zen — als primaerer (Tab-waehlbarer) Agent bis das
    // Free-Kontingent verbraucht ist, danach auf die deepseek-Primaries wechseln.
    // Dieselbe benannte Allow-Liste wie der Orchestrator (Prinzip T002298).
    "big-pickle": {
      "description": "PRIMARY: Big Pickle on OpenCode Zen (free tier). Tab-selectable singleagent model — use it while the free Zen quota lasts, then switch to the deepseek-pro/flash primaries. Runs through the zen gateway (opencode-zen/big-pickle), not the Go catalog. Can dispatch the same subagent set as the orchestrator.",
      "mode": "primary",
      "model": "opencode-zen/big-pickle",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#F472B6",
      "temperature": 0.2,
      "steps": 150,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "local": "allow",
          "deepseek-helper-go": "allow",
          "deepseek-helper": "allow",
          "deepseek-pro": "allow",
          "deepseek-pro-direct": "allow",
          "deepseek-flash": "allow",
          "deepseek-flash-direct": "allow",
          "reviewer": "allow"
        }
      }
    },
    // Ox Alpha Free — zweiter Free-Tier-Primary neben Big Pickle [2026-08-22].
    // Dispatcht ausschliesslich ox-alpha (exakte Namen statt Wildcard).
    "ox-alpha-free": {
      "description": "PRIMARY: Ox Alpha Free on OpenCode Zen (laguna-s-2.1-free, Poolside agentic coding model, free tier, 256k ctx per models.dev). Tab-selectable singleagent next to big-pickle. Live-smoke-tested 2026-08-22. Dispatches ONLY ox-alpha subagents.",
      "mode": "primary",
      "model": "opencode-zen/laguna-s-2.1-free",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#38BDF8",
      "temperature": 0.2,
      "steps": 150,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "ox-alpha": "allow"
        }
      }
    },
    "ox-alpha": {
      "description": "Subagent twin of ox-alpha-free on OpenCode Zen (same laguna-s-2.1-free model, Poolside agentic coding model, free tier). Sole dispatch target of ox-alpha-free — keeps parallel/specialized work inside the same free-tier model family. Write-capable.",
      "mode": "subagent",
      "model": "opencode-zen/laguna-s-2.1-free",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#0EA5E9",
      "temperature": 0.2,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Plan-Primary: Qwen3.6-35B-A3B MoE via FreeToken/lm-proxy (200k served KV).
    // Autonomous ticket-hammering agent: prioritizes critical issues,
    // plans (/dev-flow-plan), explores (/opsx:explore), executes, archives.
    "qwen38-primary": {
      "description": "PRIMARY: Local Qwen3.6-35B-A3B MoE via FreeToken/lm-proxy (200k served KV static pool, moe 4150, gemessen 2026-09-16). Autonomous ticket-hammering agent: prioritizes critical issues, plans (/dev-flow-plan), explores (/opsx:explore), executes, and archives one by one. Tab-selectable.",
      "mode": "primary",
      "model": "llamacpp-local/Qwen3.6-35B-A3B-NVFP4",
      "prompt": "{file:./prompts/qwen38-primary.md}",
      "color": "#10B981",
      "temperature": 0.3,
      "steps": 150,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "local": "allow",
          "deepseek-helper-go": "allow",
          "deepseek-helper": "allow",
          "deepseek-pro": "allow",
          "deepseek-pro-direct": "allow",
          "deepseek-flash": "allow",
          "deepseek-flash-direct": "allow"
        }
      }
    }
  }
}
