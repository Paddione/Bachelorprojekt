{
  "provider": {
    // Lokaler llama.cpp-Provider ueber den llm-proxy.
    //
    // Ersetzt die frueheren Bloecke llamacpp-gemma26 und llamacpp-gemma9 [2026-08-03].
    // Deren Modelle (gemma26-factory, gemma9-factory) sind Loadouts, deren GGUF-Dateien
    // auf diesem Host nicht mehr existieren — von den acht Loadouts in
    // scripts/llm/loadouts.json haben nur noch vier ihre Gewichte. Jeder Dispatch auf
    // die Gemma-Agenten lief damit ins Leere.
    //
    // Weiterhin ueber den llm-proxy (:18235) statt direkt auf den Server-Port: damit gilt
    // max_inflight=3 auch fuer die opencode-Agenten (bis zu 3 parallele Streams pro Backend)
    // und die Fallback-Kette lokal -> deepseek -> zen greift auch hier [T002558].
    "llamacpp-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp via llm-proxy (~/opt/llama-current, aktuell Build 61 / 0adcc3bb5)",
      "options": {
        "baseURL": "http://127.0.0.1:18235/v1",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "hauhau-qwen36": {
          "name": "Qwen3.6-35B-A3B Uncensored (HauhauCS Aggressive, Q4_K_M), Loadout hauhau-qwen36 auf Port 8097 - Start: curl -XPOST 127.0.0.1:18235/admin/loadouts/hauhau-qwen36/start",
          // ctx 131072 = Loadout-Flag, noch nicht gemessen (T015175) — nach Erststart
          // gegen n_ctx_slot kalibrieren. Abliteration: 0/465 Refusals, kann
          // Instruktionsfolge vs. Baseline-Qwen3.6 leicht verschlechtern.
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "gptoss-context": {
          "name": "gpt-oss-20b Q8_0 (MXFP4-nativ), Loadout gptoss-context auf Port 8098 - Start: curl -XPOST 127.0.0.1:18235/admin/loadouts/gptoss-context/start",
          // 105472 ist GEMESSEN (llama-server meldete n_ctx_slot=105472 beim Laden am
          // 2026-08-03), nicht n_ctx_train. Durchsatz derselbe Lauf: 165 tok/s prompt,
          // 147 tok/s decode.
          "limit": {
            "context": 105472,
            "output": 8192
          }
        },
        "gemma26-factory": {
          "name": "Gemma 4 26B A4B IQ4_XS, Loadout gemma26-factory auf Port 8091 (np=3, -kvu, q4_0, fitt 128) - exclusiveGroup chat-gpu",
          // 161024 ist GEMESSEN (n_ctx_slot im Serverlog, 2026-08-09, b10241, np=3 -kvu
          // q4_0 fitt 128): GEMEINSAMER Pool ueber die drei Slots, nicht je Slot.
          "limit": {
            "context": 161024,
            "output": 8192
          }
        },
        // 2026-08-04: Familiensubagenten brauchten eigene Loadouts — gemma4
        // (Port 8090) und qwen3-coder-30b (Port 8094) lagen auf der Platte.
        // Beide teilen exclusiveGroup chat-gpu: es laeuft immer nur eines.
        // T003204/T012414: qwen3-coder-30b ist abgeschaltet und aus
        // loadouts.json entfernt (vorher nur enabled: false in
        // loadouts.json) — gleicher VRAM wie gemma26-factory bei aggressiverer
        // Quantisierung, weniger Kontext, langsamer gemessen; kein Agent
        // referenziert das Modell mehr.
        // gemma4 faengt seit T002886 (2026-08-09) Gemma 4 26B A4B UD-IQ4_XS
        // und ist ein Serving-Familientraeger ohne Agenten-Referenz (der gemma-
        // Agent zeigt auf gemma26-factory).
        "gemma4": {
          "name": "Gemma 4 26B A4B UD-IQ4_XS (Serving, Loadout gemma4 auf Port 8090, np=1, q4_0 KV, gemessen 177.920 ctx) - exclusiveGroup chat-gpu",
          "limit": {
            "context": 177920,
            "output": 8192
          }
        },
        "gemma12-vision": {
          "name": "Gemma 4 12B QAT UD-Q4_K_XL + mmproj-F16 + MTP-Drafter, Loadout gemma12-vision auf Port 8089 - exclusiveGroup chat-gpu. Vision-capable.",
          "limit": {
            "context": 262144,
            "output": 8192
          }
        },
        "gemma26-throughput": {
          "name": "Gemma 4 26B A4B QAT-Q4_K_XL (Durchsatz, Loadout gemma26-throughput auf Port 8092, gemessen 118.016 ctx, 159-169 tok/s) - exclusiveGroup chat-gpu",
          "limit": {
            "context": 118016,
            "output": 8192
          }
        },
        "qwen38-220k": {
          "name": "Qwen 3.8 27B UD-IQ3_XXS (Text, Loadout qwen38-220k auf Port 8094, 114.688 ctx) - exclusiveGroup chat-gpu",
          "limit": {
            "context": 114688,
            "output": 8192
          }
        }
      }
    },
    // ── FreeToken-native (Windows pk-desktop, Port 1919) ───────────────
    // T014105/T014028: FreeToken serviert EIN residentes MoE-Modell auf dem
    // gemeinsamen Port; der Daemon (:1900) wechselt per /engine/switch. Der
    // Server ignoriert das model-Feld von Anfragen (live gegengeprueft
    // 2026-08-23) — deshalb zeigen alle lokalen Agenten auf den Alias
    // "active" statt auf konkrete Checkpoints.
    //
    // Kontext-Limits sind GEMESSEN (2026-08-23, pk-desktop, RTX 5070 Ti,
    // FreeToken 0.1.1+g30aa89115), NICHT advertised: der Server meldet
    // max_model_len=262144, nutzbar sind aber nur die KV-Pages der jeweiligen
    // Serve-Konfiguration. opencode kompaktiert bei 95% der deklarierten
    // Grenze — die advertised Zahl reproduziert exakt die
    // "Input sequence length exceeds"-Drops, gegen die die Kalibrierung
    // gebaut wurde. Das Plugin .opencode/plugin/freetoken-active.ts setzt
    // Limit+Name des Alias beim opencode-Start auf das residente Modell.
    "freetoken-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "FreeToken-native (drei MoE-FTW-Checkpoints auf pk-desktop/Windows, je EINER resident auf :1919, Wechsel ueber Daemon :1900 /engine/switch)",
      "options": {
        "baseURL": "http://127.0.0.1:1919/v1"
      },
      "models": {
        "Qwen3.6-35B-A3B-NVFP4": {
          "name": "Qwen3.6-35B-A3B NVFP4 (FreeToken-native, GDN-Hybrid, gemessen 2026-08-23: ~104 tok/s Decode kurz / 62-70 tok/s bei 63k Kontext, 131072 KV-Reserve = 34% Experten resident, text-only)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "gpt-oss-20b": {
          "name": "gpt-oss-20b FTW (FreeToken-native, gemessen 2026-08-23: ~112 tok/s Decode bei 64k KV / ~128 tok/s bei 32k KV, 75.7% Experten resident, Reasoning-Stufen low/medium/high statt on/off, text-only by architecture)",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "Gemma-4-26B-A4B-NVFP4": {
          "name": "Gemma-4-26B-A4B NVFP4 (FreeToken-native, gemessen 2026-08-23: ~73 tok/s Decode bei 32k KV nach Window-Pool-Trimmung --swa 8777 --moe 1540, 40% Experten resident, text-only bis Vision-Rekonvertierung — FTW-Checkpoint enthaelt null Vision-Tensoren)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "active": {
          "name": "FreeToken-active (modellagnostischer Alias — serviert immer das gerade auf :1919 residente Modell; Limit wird vom Plugin freetoken-active beim Start auf das residente Modell gesetzt, Fallback hier: Qwen)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    },
    // ── Alibaba Cloud International (Token Plan) ───────────────────────
    // OpenAI-compatible Endpoint für Qwen/Claude Modelle via Alibaba MaaS.
    // Kein "apiKey" hier [2026-08-14, T004808]: Der Key stand plaintext im
    // Repo und ist als kompromittiert zu behandeln (Rotation offen). Er
    // liegt jetzt in ~/.local/share/opencode/auth.json — so hält es der
    // opencode-go-Provider unten ebenfalls; ohne apiKey-Feld greift opencode
    // genau dort zu.
    // baseURL: https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
    "alibaba-intl": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Alibaba Cloud International (Token Plan, MaaS)",
      "options": {
        "baseURL": "https://token-plan.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1"
      },
      "models": {
        // Model-ID vom Token Plan — abgefragt via /compatible-mode/v1/models.
        // Erreichbar über compatible-mode (OpenAI-Format), nicht DashScope-native.
        "qwen3.8-max": {
          "name": "Qwen3.8 Max (Alibaba Intl Token Plan, via compatible-mode)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        // 2026-08-22 GEMESSEN nach Key-Rotation: GET /compatible-mode/v1/models
        // listet beide DeepSeek-Modelle; chat/completions-Smoke antwortet
        // (pro: "OK"/finish=stop; flash-0731: "OK"/finish=length — das ist der
        // bekannte Reasoning-Budget-Effekt, kein Fehler). ACHTUNG: die ID
        // heisst hier "deepseek-v4-flash-0731", NICHT "deepseek-v4-flash" wie
        // auf der direkten API / Go-Gateway.
        // Kontext-/Output-Limits sind NICHT gemessen — konservative Deklaration
        // (upstream ist DeepSeek V4 mit 1M ctx, aber das Token-Plan-Gateway-
        // Limit ist unbelegt; opencode nutzt die Zahl nur fuer Auto-Compact).
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek V4 Flash 0731 (Alibaba Intl Token Plan, compatible-mode)",
          "limit": {
            "context": 131072,
            "output": 8192
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (Alibaba Intl Token Plan, compatible-mode)",
          "limit": {
            "context": 131072,
            "output": 16384
          }
        }
      }
    },

    // OpenCode Zen/Go: "opencode-go" statt "opencode" (Zen) - Subscription-Tier
    // ($10/mo), deepseek-v4-flash ist Teil des Go-Katalogs (verifiziert per curl
    // gegen https://opencode.ai/zen/go/v1/chat/completions, cost:"0" = im Abo
    // enthalten).
    //
    // Kein "apiKey" hier [2026-08-03]: Der Eintrag lautete frueher
    // "{env:OPENCODE_API_KEY}" und verwies auf ~/.config/opencode/secrets.env.
    // Diese Datei existiert nicht und die Variable ist in keiner Shell gesetzt —
    // die Referenz loeste sich also ins Leere auf. Der Schluessel liegt
    // tatsaechlich in ~/.local/share/opencode/auth.json, wo `opencode auth login`
    // ihn ablegt (`opencode auth list` zeigt DeepSeek und OpenCode Go). Ohne
    // apiKey-Feld greift opencode genau dort zu — so haelt es der
    // deepseek-Provider oben ebenfalls.
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (Subscription)",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (OpenCode Go, 1M ctx, MoE 284B/13B active)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        // 2026-08-03: v4-pro ist im Go-Katalog enthalten und antwortet
        // (verifiziert per GET /models UND per chat/completions). Er fehlte
        // hier, weshalb der Tiefen-Subagent unnoetig ueber die direkte API
        // lief, statt das bezahlte Abo zu nutzen.
        //
        // Der Go-Katalog fuehrt weit mehr als diese zwei: minimax-m3,
        // kimi-k3, glm-5.2, qwen3.8-max und andere. Sie sind hier bewusst
        // NICHT eingetragen — jeder Eintrag will gemessen sein, bevor ein
        // Agent darauf zeigt.
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (OpenCode Go, 1M ctx, maximale Reasoning-Tiefe)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    },
    // OpenCode Zen (https://opencode.ai/zen/v1) — der Katalog MIT `big-pickle`,
    // das auf dem Go-Katalog (/zen/go/v1) fehlt. Gleicher Auth-Schluessel wie
    // opencode-go: der Key wird via `opencode auth` unter dem Provider-Namen
    // "opencode-zen" in ~/.local/share/opencode/auth.json gehalten. big-pickle
    // laeuft im Free-Kontingent — bis das verbraucht ist, dann auf die
    // deepseek-Primaries wechseln.
    "opencode-zen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen (big-pickle, bis Free-Kontingent verbraucht)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle (OpenCode Zen, free tier — bis das Free-Kontingent verbraucht ist)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        },
        // GEMESSEN [2026-08-22]: per GET /zen/v1/models gelistet UND per
        // chat/completions gegengeprueft (Antwort "OK", finish_reason=stop).
        // limit laut models.dev-Registry (opencode-Provider): 256k ctx,
        // 32k output, cost 0/0 — agentic coding model von Poolside,
        // tool_call=true. models.dev markiert es als deprecated; im Liveversuch
        // antwortete es trotzdem. deepseek-v4-flash-free wurde im selben Lauf
        // ebenfalls getestet und ist UPSTREAM NICHT VERFUEGBAR ("Model is
        // unavailable") — deshalb steht hier laguna, nicht das naheliegendere
        // DeepSeek-Free.
        "laguna-s-2.1-free": {
          "name": "Laguna S 2.1 Free (OpenCode Zen, free tier, Poolside agentic coding model, models.dev: 256k ctx)",
          "limit": {
            "context": 256000,
            "output": 32000
          }
        }
      }
    },
    // Direkte DeepSeek-API als Ausweichweg, wenn OpenCode Go nicht traegt
    // (Abo-Limit, Zen-Ausfall). Key liegt in ~/.local/share/opencode/auth.json
    // unter dem Provider-Schluessel "deepseek" (via `opencode auth`).
    //
    // Warum die IDs hier explizit stehen [2026-08-03, gemessen]:
    // GET https://api.deepseek.com/models fuehrt nur noch deepseek-v4-flash
    // und deepseek-v4-pro. Die frueher konfigurierten deepseek-chat und
    // deepseek-reasoner sind aus der Liste verschwunden — sie ANTWORTEN aber
    // weiterhin (beide per chat/completions gegengeprueft, finish_reason=stop).
    // Es sind also undokumentierte Aliase, kein Totalausfall. Der Wechsel auf
    // V4 erfolgt deshalb nicht als Fehlerbehebung, sondern wegen des
    // Kontextfensters: 1M statt 128K/200K.
    //
    // Beide V4-Modelle sind Reasoning-Modelle und fuellen reasoning_content
    // zusaetzlich zu content. Wer sie mit knappem max_tokens testet, sieht
    // content="" bei finish_reason="length" — das Budget ging fuers Denken
    // drauf und ist KEIN Fehler des Modells.
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (direkte API, Ausweichweg zu OpenCode Go)",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (direkte API)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (direkte API, maximale Reasoning-Tiefe)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    },
    // LM Studio — Modelle auf den zwei im LAN angeschlossenen Laptops
    // (Embedding-Modelle und kleine lokale Modelle). Kein Agent dispatcht
    // direkt hierauf; dient als Provider-Registry fuer die LAN-Geraete.
    "lmstudio": {
      "models": {
        "qwen3.5-9b@q4_k_xl": {
          "name": "Qwen3.5-9B (1 session, 140k ctx, UD-Q4_K_XL weights, Q8_0 KV)",
          "limit": {
            "context": 140000,
            "output": 8192
          }
        },
        "qwen3.5-9b@q4_k_m": {
          "name": "Qwen3.5-9B (3x48k parallel, Q4_K_M weights, Q8_0 KV)",
          "limit": {
            "context": 48000,
            "output": 8192
          }
        },
        "qwen3.5-9b@iq4_xs": {
          "name": "Qwen3.5-9B (4x65k parallel, IQ4_XS weights, 260k total ctx)",
          "limit": {
            "context": 260000,
            "output": 8192
          }
        },
        "qwen3-14b@q4_k_m": {
          "name": "Qwen3-14B (1 session, Q4_K_M, lmstudio-community/Qwen3-14B-GGUF)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "google/gemma-4-12b-qat": {
          "name": "Gemma 4 12B (QAT)",
          "limit": {
            "context": 180000,
            "output": 8192
          }
        },
        "gemma-4-12b-agentic-fable5-composer2.5-v2-3.5x-tau2@q4_k_m": {
          "name": "Gemma4 v2 12B + 423M MTP-Assistant draft (speculative decoding, yuxinlu1, Q4_K_M weights, Q8_0 KV)",
          "limit": {
            "context": 150000,
            "output": 8192
          }
        },
        // GEMESSEN (K3, k3-messung.sh qwen3.5-4b@q6_k 5, 2026-08-15): ~7,8-9,5
        // tok/s Decode, Thinking nicht abschaltbar — 8192 Output waere bei
        // ~9,5 tok/s 14-17 Min/Request, deshalb 4096. Repo-Stand der Messung:
        // 47c5abca6. E2B-Slot (T007055): HF-Beleg Dateigroesse 3.184.496.736
        // Bytes (~2,97 GiB) — die E4B-UD-Q4_K_XL ist real 4,77 GiB gross und
        // sprengt das 8-GB-RAM-Budget des Iris-Plus-Tablets, deshalb context
        // 16384. Die Tablet-K3-Messung folgt im Geraete-Folgetask
        // (T007055-Geraeteteil).
        "gemma-4-e2b@ud-q4_k_xl": {
          "name": "Gemma 4 E2B UD-Q4_K_XL (~2,97 GiB, PK-Tablet)",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        },
        "qwen3.5-4b@q6_k": {
          "name": "Qwen3.5-4B Q6_K (~3,3 GB, PK-L-1)",
          "limit": {
            "context": 32768,
            "output": 4096
          }
        }
      }
    }
  },
  "agent": {
    // LOKALE SUBAGENTEN NACH MODELL-FAMILIE [2026-08-04].
    //
    // Frueher hiessen sie gemma26-1/2 und gemma9-1/2 und zeigten ALLE auf
    // gptoss-context — der Name log ueber das Modell. Seit 2026-08-04 traegt
    // jeder lokale Subagent den Namen der Familie, die er tatsaechlich serviert
    // (gptoss, devstral, gemma, gemma12), und der Orchestrator ruft ihn damit auf:
    // `task gemma` gibt die Gemma-Familie. T003204: die Familie qwen ist
    // abgeschaltet — ihr Loadout qwen3-coder-30b wurde entfernt (T012414).
    //
    // Was unveraendert gilt: der llm-proxy hat max_inflight=3, die Agenten
    // rechnen nacheinander. Mehr Namen bringen erhaltenen Kontext, nicht
    // Durchsatz — bei einer einzelnen GPU waere echte Nebenlaeufigkeit ohnehin
    // kaum ein Gewinn. Alle vier Chat-Loadouts teilen exclusiveGroup
    // "chat-gpu": es laeuft immer nur eines.
    //
    // Der urspruengliche Hinweis aus T002298 bleibt gueltig: "-np" heisst in
    // llama.cpp "number of server slots", nicht "Parallelitaet". Wer die Namen
    // zusammenstreicht, nimmt jedem Agenten seinen Praefix-Cache.
    // T003204: faehrt seit dem Abschalten von gptoss-context das Loadout
    // gemma26-throughput (118.016 ctx). Der NAME bleibt "gptoss", obwohl er nun
    // ueber das Modell luegt — er ist die Aufruf-Schnittstelle des Orchestrators
    // ("gptoss": "allow" in dessen Permission-Liste) und steht zusaetzlich in
    // docs/agent-guide/registry/agents.yaml sowie in der Skill-Dokumentation.
    // Umbenennen ist ein eigener Vorgang mit eigener Pruefung; hier sagt die
    // description, welches Modell tatsaechlich dahintersteht.
    "gptoss": {
      "description": "Local subagent, modellagnostisch auf FreeToken-native (:1919) — der Alias 'active' serviert immer das gerade residente Modell (Plugin freetoken-active setzt das Kontext-Limit beim opencode-Start). Name retained as orchestrator dispatch handle. Text-only. Sequential dispatch.",
      "mode": "subagent",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#34D399",
      "temperature": 0.4,
      "steps": 50,
      // write=deny: subagent überschreibt sonst ganze Dateien statt surgical edit
      // (beobachtet 2026-07-23, T002137: subagents löschten existierende Files).
      // Neue Dateien erzeugt der Orchestrator nach Erhalt des Contents.
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    // T003204: faehrt seit dem Abschalten von devstral-quality das Loadout
    // gemma26-factory (177.920 ctx). Zum beibehaltenen Namen siehe den Hinweis
    // bei "gptoss" oben.
    "devstral": {
      "description": "Local subagent, modellagnostisch auf FreeToken-native (:1919) — der Alias 'active' serviert immer das gerade residente Modell (Plugin freetoken-active setzt das Kontext-Limit beim opencode-Start). Name retained as orchestrator dispatch handle. Text-only. Sequential dispatch.",
      "mode": "subagent",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#60A5FA",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    "gemma": {
      "description": "Local subagent, modellagnostisch auf FreeToken-native (:1919) — der Alias 'active' serviert immer das gerade residente Modell (Plugin freetoken-active setzt das Kontext-Limit beim opencode-Start). Name retained as orchestrator dispatch handle. Text-only. Sequential dispatch.",
      "mode": "subagent",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#F59E0B",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    // T003204: gemma12-vision als Familien-Subagent aufgenommen. Es ist mit
    // 262.144 ctx das kontextstaerkste lokale Loadout und das EINZIGE mit Vision
    // (mmproj-F16). Bisher war es nur als Primary (gemma12-primary) erreichbar,
    // also nicht per `task` dispatchbar — der Orchestrator konnte es nicht rufen.
    // Der Eintrag in der Permission-Liste weiter unten gehoert dazu: ohne ihn
    // existiert der Agent, ist aber nicht dispatchbar.
    "gemma12": {
      "description": "Local subagent, modellagnostisch auf FreeToken-native (:1919) — der Alias 'active' serviert immer das gerade residente Modell (Plugin freetoken-active setzt das Kontext-Limit beim opencode-Start). Name retained as orchestrator dispatch handle. Text-only. Sequential dispatch.",
      "mode": "subagent",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#F0ABFC",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    // 2026-08-22: qwen38 als fuenfter Familien-Subagent. Zeigt auf das Loadout
    // qwen38-220k (Port 8094, Qwen 3.8 27B UD-IQ3_XXS, fixierte 114.688 ctx,
    // q4_0 KV) — dasselbe Modell wie der Tab-waehlbare qwen38-primary, aber
    // per `task` dispatchbar. EIN Slot (parallel=1 in loadouts.json): dieser
    // Agent ist bewusst NICHT parallel zu sich selbst oder zu den anderen
    // lokalen Familien dispatchbar — sequenziell, einer nach dem anderen.
    // Text-only: kein mmproj in diesem Loadout.
    "qwen38": {
      "description": "Local subagent for the qwen38 family — name retained as dispatch handle; faehrt seit T014028 FreeToken-native (:1919), modellagnostisch via Alias 'active' (serviert immer das residente Modell). Text-only. Write-capable delegation.",
      "mode": "subagent",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#22D3EE",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    // 2026-08-22: qwen-cloud als erste Cloud-Eskalationsstufe nach lokal.
    // Qwen 3.8 Max via Alibaba Cloud Intl Token Plan — selbe Modell-Familie
    // wie der Orchestrator, staerker als jedes lokale Modell, 131k ctx.
    // Eskalationskette: lokal (qwen38-220k 27B) →
    // qwen-cloud (Qwen3.8-Max) → deepseek-helper → deepseek-pro.
    "qwen-cloud": {
      "description": "Cloud subagent: Qwen 3.8 Max via Alibaba Cloud Intl Token Plan (131k ctx). First cloud escalation tier after local models fail. Same model family as the orchestrator. Write-capable.",
      "mode": "subagent",
      "model": "alibaba-intl/qwen3.8-max",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#FF6900",
      "temperature": 0.3,
      "steps": 100,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Primaerer (Tab-waehlbarer) Lokal-Agent auf gemma26-factory.
    // "mode": "primary" heisst: vom Benutzer direkt gewaehlt, NICHT per `task`
    // summonbar. Kann beliebige Subagenten dispatchen (deepseek + lokal).
    //
    // Gedacht fuer Arbeit, die komplett lokal laufen soll, ohne DeepSeek-
    // Orchestrator davor.
    "gemma26-primary": {
      "description": "Primary (Tab-selectable) local agent on FreeToken-native (:1919), modellagnostisch via Alias 'active'. Text-only. Use for fully local work without the cloud orchestrator. Can dispatch subagents.",
      "mode": "primary",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#6EE7B7",
      // Zwischen Orchestrator (0.2) und Subagent (0.4): der primaere Agent
      // plant UND implementiert. Deutlich hoehere Werte riskieren den
      // Tool-Call-im-<think>-Block-Fehler aus der fablevibes-Diagnose.
      "temperature": 0.3,
      "steps": 50,
      // write=deny aus demselben Grund wie beim Subagenten - das ist eine
      // Modell-Eigenschaft (Ganzdatei-Overwrite statt Edit), keine Frage des
      // Agent-Modus. Neue Dateien legt der Benutzer bzw. ein Folgeschritt an.
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "allow" }
    },
    // Maximaler lokaler Kontext (161024, gemessen beim Laden am 2026-08-09,
    // np=3 -kvu q4_0 fitt 128, gemeinsamer Pool).
    // Keinerlei Subagent-Dispatch — rein lokale Arbeit ohne Netzanbindung.
    //
    // Kein Vision: gemma26-factory laedt KEIN mmproj (loadouts.json, notes
    // "Kein mmproj." — der mmproj-Pfad wurde T002886 entfernt, weil die Datei
    // am erwarteten Pfad fehlte). Vision gibt es nur auf gemma12-vision (:8089).
    "gemma26-vision": {
      "description": "PRIMARY: modellagnostisch auf FreeToken-native (:1919, Alias 'active' = residentes Modell). Tab-selectable singleagent on the freetoken-local provider. Text-only. No subagent dispatch — for focused local work that must stay on-device.",
      "mode": "primary",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#A78BFA",
      "temperature": 0.3,
      "steps": 50,
      "permission": {
        "edit": "allow",
        "write": "deny",
        "bash": "allow",
        "task": "deny"
      }
    },
    // ── Primaere (Tab-waehlbare) Agenten fuer jedes lokale Modell ───────
    //
    // Ergaenzung zu gemma26-primary / gemma26-vision: ein primaerer Agent pro
    // lokalem GGUF-Modell, damit der Benutzer jedes Modell direkt per Tab
    // auswaehlen kann, ohne den Orchestrator davor. Alle nutzen den gleichen
    // Prompt (local-subagent.md) und das gleiche Berechtigungsprofil:
    // edit=allow, write=deny, bash=allow, task nur deepseek-Eskalation.
    // T003204: Kontextzahl mitgezogen — sie ist NICHT kosmetisch. opencode nutzt
    // die deklarierte Zahl zur Laufzeit fuer Auto-Compact (fasst bei 95 % der
    // Grenze zusammen); eine stehengebliebene 105.472 gegen die tatsaechlichen
    // 118.016 fuehrte zu falsch getimtem Compact. Der Guard
    // opencode-routes-via-proxy.bats prueft die Deklaration gegen den LAUFENDEN
    // Server in einem +/-20-%-Korridor.
    "gptoss-primary": {
      "description": "PRIMARY: modellagnostisch auf FreeToken-native (:1919, Alias 'active' = residentes Modell). Tab-selectable singleagent on the freetoken-local provider. Text-only. Can dispatch subagents.",
      "mode": "primary",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#34D399",
      "temperature": 0.3,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "allow" }
    },
    "devstral-primary": {
      "description": "PRIMARY: modellagnostisch auf FreeToken-native (:1919, Alias 'active' = residentes Modell). Tab-selectable singleagent on the freetoken-local provider. Text-only. Can dispatch subagents.",
      "mode": "primary",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#60A5FA",
      "temperature": 0.3,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "allow" }
