{
  "provider": {
    // Lokaler Provider auf :1919 [T900208, T900348, T900359, T900365].
    //
    // Der Key heisst aus historischen Gruenden "llamacpp-local" (Modell-Strings
    // und opencode-Default referenzieren ihn). Seit T900348 steht dahinter wieder
    // llama.cpp, seit 2026-10-26 Qwen3.8-27B GSQ-RCO IQ2_S-mtp (139264 served KV,
    // MTP n-max 4, -ub 512, -cram 12288) auf der RTX 5070 Ti allein
    // (scripts/llm/qwen38-gsq-iq2s.service).
    // Die Modell-ID "Qwen3.8-27B" ist der opencode-seitige Name (llama-server ignoriert ihn;
    // live-Alias: Qwen3.8-27b-gsq-rco-iq2s; davor IQ3_XXS-mtp mit 153600 KV, davor
    // opencode-Alias "Muse-Glimmer-30B", T900365).
    // Davor opencode-Alias "Muse-Glimmer-30B" (T900365), Qwen3.8 GSQ-RCO IQ3_XXS ohne MTP (T900359), FreeToken (T900203).
    //
    // Direkt statt ueber den llm-proxy (:18235): der Proxy ist seit 2026-09-03
    // stillgelegt (ADR-007). Der Server bedient einen Slot (-np 1); weitere
    // Requests warten in seiner Queue. Ausweichen auf Cloud (exe-muse) ist
    // eine explizite Agenten-Wahl.
    "llamacpp-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp :1919 (Qwen3.8-27B GSQ-RCO IQ2_S-mtp, RTX 5070 Ti, 139264 served KV)",
      "options": {
        "baseURL": "http://127.0.0.1:1919/v1",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        // GEMESSEN 2026-10-03 (llama.cpp e85e15cf6, 5070 Ti allein, q4_0-KV,
        // draft-mtp n-max 4, scripts/llm/measurements/2026-10-03-qwen38-iq2s-vs-iq3xxs.md):
        // Short-Prompt Decode 106 t/s (MTP-Annahme 66 %), 6641-Token-Prompt:
        // Prefill 1471 tok/s, Decode 99 tok/s. Orchestrierungs-Bench 15/15,
        // LiveCodeBench v6 84.57 %, GPQA-Diamond 88.89 %. VRAM 15059 MiB.
        // Dense 27B; das Chat-Template setzt "Reasoning strength: high"
        // selbst -> kleines max_tokens liefert leeren content (length) — Budget
        // grosszuegig. 139264 = served KV (-c der Unit).
        // limit.input ist Pflicht fuer den V1-Compaction-Trigger: ohne ihn
        // ignoriert opencode compaction.reserved und kompaktiert erst bei
        // context − output (T900362, siehe opencode.jsonc).
        "Qwen3.8-27B": {
          "name": "Qwen3.8-27B GSQ-RCO IQ2_S-mtp (llama.cpp :1919, RTX 5070 Ti, 139264 served KV, ~78 tok/s reasoning)",
          "limit": {
            "context": 139264,
            "input": 139264,
            "output": 8192
          }
        }
      }
    },
    // OpenCode Zen/Go: "opencode-go" statt "opencode" (Zen) - Subscription-Tier
    // ($10/mo). Nur Modelle mit gemessener Bindung werden hier eingetragen
    // (verifiziert per `opencode run --model ...` IN-CLIENT — rohes curl wird
    // abgewiesen, die Rails verlangen den opencode-Client: MissingSessionID
    // (go) bzw. FreeTierError (zen); cost:"0" = im Abo enthalten).
    //
    // Kein "apiKey" hier [2026-08-03]: Der Schluessel liegt in
    // ~/.local/share/opencode/auth.json, wo `opencode auth login` ihn ablegt.
    // Ohne apiKey-Feld greift opencode genau dort zu.
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (Subscription)",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        // Der Go-Katalog fuehrt weit mehr (minimax-m3, kimi-k3, glm-5.2,
        // qwen3.8-max u.a.). Sie sind hier bewusst NICHT eingetragen — jeder
        // Eintrag will gemessen sein, bevor ein Agent darauf zeigt.
        // T900210: Muse Spark 1.3 Contributor im Go-Katalog (Katalogwerte:
        // 1M ctx / 131k output). Seit 2026-10-03 die EINZIGE genutzte
        // Muse-Bindung (in-client verifiziert: `opencode run --model
        // opencode-go/muse-spark-1.3-contributor#low` antwortet korrekt); die
        // alte ModelProtocolUnsupported-Einschraenkung auf /chat/completions
        // gilt nicht mehr. Auth via ~/.local/share/opencode/auth.json.
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor (OpenCode Go, 1M ctx, 131k output)",
          "reasoning": true,
          "variants": {
            "none": {},
            "minimal": {},
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {}
          },
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    },
    // STILLGELEGT 2026-10-03 (Root-Cause verifiziert, T900939): `{env:}`
    // wird korrekt aufgeloest (per lokalem Echo-Server bewiesen) — aber die
    // Go/Zen-Rails akzeptieren KEINE rohen API-Keys als Bearer
    // (`Invalid credential`, auf chat UND /responses). Nur der
    // Managed-Credential-Pfad funktioniert: ohne `apiKey`-Feld sendet opencode
    // das gemanagte Token aus opencode.db (Tabelle `credential`), nicht den
    // auth.json-Key roh (per Wiretap bewiesen). Alle Konsumenten zeigen auf
    // `opencode-go` (s.o.). Historie: OpenAI-RESPONSES-Protokoll —
    // /chat/completions lehnte das Modell mit `ModelProtocolUnsupported` ab
    // (gilt seit 2026-10-03 nicht mehr); eigener Block wegen fehlendem
    // per-model `npm`.
    "opencode-go-oai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenCode Go (Responses-Protokoll — muse-spark-1.3-contributor)",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_GO_API_KEY}"
      },
      "models": {
        "muse-spark-1.3-contributor": {
          "name": "Muse Spark 1.3 Contributor (Go /responses, 1M ctx, 131k output)",
          "reasoning": true,
          "variants": {
            "none": {},
            "minimal": {},
            "low": {},
            "medium": {},
            "high": {},
            "xhigh": {},
            "max": {}
          },
          "limit": { "context": 1000000, "output": 131072 }
        }
      }
    },
    // OpenCode Zen (https://opencode.ai/zen/v1) — der Katalog MIT `big-pickle`,
    // das auf dem Go-Katalog (/zen/go/v1) fehlt. Gleicher Auth-Schluessel wie
    // opencode-go (via `opencode auth` unter "opencode-zen" gehalten). big-pickle
    // laeuft im Free-Kontingent — bis das verbraucht ist, dann auf exe-muse
    // wechseln (T900751).
    "opencode-zen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen (big-pickle, bis Free-Kontingent verbraucht)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle (OpenCode Zen, free tier — bis das Free-Kontingent verbraucht ist)",
          // messung: 2026-09-12 — Free-Quota-Korrektur: models.dev-Basis 256k, deklariert
          // 260000. 1.000.000 war Free-Quota-Wunschdenken; opencode nutzt die Zahl fuer
          // Auto-Compact (95%-Trigger) — ein zu hoher Wert reproduziert Overflow-Drops.
          "limit": {
            "context": 260000,
            "output": 16384
          }
        },
        // GEMESSEN [2026-08-22]: per GET /zen/v1/models gelistet UND per
        // chat/completions gegengeprueft (Antwort "OK", finish_reason=stop).
        // limit laut models.dev-Registry (opencode-Provider): 256k ctx,
        // 32k output, cost 0/0 — agentic coding model von Poolside,
        // tool_call=true.
        "laguna-s-2.1-free": {
          "name": "Laguna S 2.1 Free (OpenCode Zen, free tier, Poolside agentic coding model, models.dev: 256k ctx)",
          "limit": {
            "context": 256000,
            "output": 32000
          }
        },
        // T900210: Muse Spark 1.3 Contributor Free im Zen-Katalog (1M ctx /
        // 131k output, $0/$0, Training-Data-Sharing). Free-first Default fuer
        // Orchestrator-Planung; Go-Variante ist der Fallback (exe-muse).
        "muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Contributor Free (OpenCode Zen, free tier, 1M ctx, 131k output)",
          "limit": {
            "context": 1000000,
            "output": 131072
          }
        }
      }
    },
    // Zen-Rail, aber OpenAI-RESPONSES-Protokoll: muse-spark-1.3-contributor-free
    // lehnt /chat/completions mit `ModelProtocolUnsupported` ab (aus opencode
    // heraus verifiziert). Gleiche Ursache wie beim Go-Rail, eigener Block
    // wegen fehlendem per-model `npm`. Key aus der ENV, kein Secret in Config.
    "opencode-zen-oai": {
      "npm": "@ai-sdk/openai",
      "name": "OpenCode Zen (Responses-Protokoll — muse-spark-1.3-contributor-free)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "{env:OPENCODE_ZEN_API_KEY}"
      },
      "models": {
        "muse-spark-1.3-contributor-free": {
          "name": "Muse Spark 1.3 Contributor Free (Zen /responses, 1M ctx, 131k output)",
          "reasoning": true,
          "limit": { "context": 1000000, "output": 131072 }
        }
      }
    }
  },
  "agent": {
    // Der staerkere lokale Implementierungs-Subagent auf der 5070 Ti.
    // 2026-09-16: die fuenf Familien-Handles
    // (gptoss/devstral/gemma/gemma12/qwen38) zeigten alle auf dasselbe
    // FreeToken-Modell — fuenf Namen, ein Slot, kein Prefix-Cache-Gewinn mehr
    // (ein Resident-Checkpoint, ein Radix-Cache). Kollabiert zu einem `local`.
    // Engine: -np 1 (ein Slot); llama.cpp queuet weitere Requests als
    // sequenzielle Dispatches, die ≤139264 served KV teilen. Der Orchestrator
    // vergibt pro Dispatch budget_tokens (S ~32k / M ~80k / L ~100k).
    "local": {
      "description": "Higher-capability local implementation subagent (Qwen3.8-27B GSQ-RCO IQ2_S-mtp via llama.cpp :1919, RTX 5070 Ti, one slot; context limit 139264 shared across queued dispatches). Text-only. Sequential dispatch with per-packet budget_tokens.",
      "mode": "subagent",
      "model": "llamacpp-local/Qwen3.8-27B",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#34D399",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    // plan-runner-Worker (T900504): opencode run akzeptiert nur Primaer-Agenten; ein
    // Subagent (local) faellt dort still auf den Default-Agenten zurueck und laeuft dann mit
    // dessen Modell und Werkzeugen auf :1919. Deshalb eigene primaere Worker mit schlankem
    // Prompt; write ist erlaubt (Partials legen Dateien an), task nicht (kein Weiterdelegieren).
    // Genutzt von scripts/llm/plan-runner/workers.mjs. Der Direkt-Track des Runners braucht
    // keinen Agenten (In-Process-Tool-Loop gegen vLLM :8123, direct-worker.mjs).
    "plan-worker-self": {
      "description": "plan-runner self-execution worker on the local Qwen3.8-27B IQ2_S-mtp (llama.cpp :1919, RTX 5070 Ti; not the Slim orchestrator model, which plans on Muse Spark via Go). Executes one plan partial in one go when all 4B slots are busy; started by scripts/llm/plan-runner.mjs.",
      "mode": "primary",
      "model": "llamacpp-local/Qwen3.8-27B",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#34D399",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny" }
    },
    // plan-worker-muse (T016656): Cloud-Track des plan-runners (Muse Spark 1.3 im Go-Abo) fuer
    // Partials, die der Direkt-Worker nicht schafft. Prompt wie der fruehere vLLM-Worker
    // (schlank, kleines Kontextbudget); write erlaubt, task verboten.
    "plan-worker-muse": {
      "description": "Primary plan partial worker on Muse Spark 1.3 (opencode free/Go catalog). Cloud track of scripts/llm/plan-runner.mjs via dispatch_cloud; write-capable only for assigned partials.",
      "mode": "primary",
      "model": "opencode/muse-spark-1.3-contributor-free",
      "prompt": "{file:./prompts/vllm-worker.md}",
      "color": "#F472B6",
      "temperature": 0.3,
      "steps": 40,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny" }
    },
    "reviewer": {
      "description": "Reviewer role — read, grep, glob, tests only; no edit/write/bash/task dispatch (Orchestrator applies edits). Write-capable: deny.",
      "mode": "subagent",
      "model": "llamacpp-local/Qwen3.8-27B",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#FBBF24",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "deny", "write": "deny", "bash": "deny", "task": "deny", "glob": "allow", "grep": "allow", "list": "allow", "read": "allow", "todowrite": "allow", "question": "allow", "skill": "allow", "lsp": "allow" }
    },
    // Slim-first (chore/slim-orchestrator-setup): kein eigenes `orchestrator`-Profil mehr —
    // Slims Orchestrator ist die einzige interaktive Orchestrierungs-Definition
    // (Modell-Pinning in .opencode/oh-my-opencode-slim.jsonc, Workflow-Regeln in
    // ~/.config/opencode/oh-my-opencode-slim/orchestrator_append.md). `local`,
    // `vllm-4b`, `exe-muse` und `reviewer` bleiben als Worker verfuegbar.
    // exe-muse — Muse-Spark-Ausfuehrungs-Agent auf dem Go-Katalog
    // (Subscription, kein Training-Sharing wie Zen-free). Niedrige
    // Reasoning-Stufe (`low`) und `mode: subagent`: dispatchbar, bewusst NICHT
    // tab-waehlbar — Planung macht der Orchestrator, Ausfuehrung hier.
    // Leaf-Agent: `task: deny`, kann nicht weiterdelegieren. Eigenes Prompt
    // prompts/muse.md (Cloud-Worker-Subagent), NICHT der Orchestrator-Prompt.
    "exe-muse": {
      "description": "EXECUTOR (dispatchable, low reasoning): Muse Spark 1.3 Contributor via the OpenCode Go subscription (1M ctx). The single Muse seat: cheap reasoning tier so bulk and mechanical execution stays fast. Dispatch here for oversized or under-specified implementation work and for local-stall escalation handoffs. Leaf: cannot dispatch further.",
      "mode": "subagent",
      "model": "opencode-go/muse-spark-1.3-contributor",
      "variant": "low",
      "prompt": "{file:./prompts/muse.md}",
      "color": "#34D399",
      "temperature": 0.2,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // bp-* primaries (T900858): three thin domain primaries over the OMO
    // engine. Retire glimmer-primary (loop moved into orchestrator +
    // sdlc-autopilot), big-pickle / ox-alpha-free (free-tier fallback is a
    // model choice, not a separate primary). plan-worker-* untouched.
    "bp-build": {
      "description": "PRIMARY: build — manifests, Kustomize overlays, Taskfile, environments, sealed secrets. Tab-selectable domain entry over the OMO engine (local Qwen3.8-27B :1919).",
      "mode": "primary",
      "model": "llamacpp-local/Qwen3.8-27B",
      "prompt": "{file:./prompts/bp-build.md}",
      "color": "#FB9236",
      "temperature": 0.3,
      "steps": 150,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "local": "allow",
          "vllm-4b": "allow",
          "reviewer": "allow",
          "fixer": "allow",
          "oracle": "allow"
        }
      }
    },
    "bp-run": {
      "description": "PRIMARY: run — live cluster ops via task workspace:* and kubectl, postgres reads. Tab-selectable domain entry over the OMO engine (local Qwen3.8-27B :1919). Read-only filesystem for manifests.",
      "mode": "primary",
      "model": "llamacpp-local/Qwen3.8-27B",
      "prompt": "{file:./prompts/bp-run.md}",
      "color": "#F87171",
      "temperature": 0.3,
      "steps": 150,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "local": "allow",
          "vllm-4b": "allow",
          "exe-muse": "allow",
          "oracle": "allow"
        }
      }
    },
    "bp-ship": {
      "description": "PRIMARY: ship — BATS/Playwright, Astro/Svelte website, brand pages, test inventory. Tab-selectable domain entry over the OMO engine (Muse Spark via Go, reasoning-heavy UI/test work).",
      "mode": "primary",
      "model": "opencode-go/muse-spark-1.3-contributor",
      "variant": "low",
      "prompt": "{file:./prompts/bp-ship.md}",
      "color": "#A78BFA",
      "temperature": 0.2,
      "steps": 150,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "local": "allow",
          "vllm-4b": "allow",
          "reviewer": "allow",
          "designer": "allow",
          "librarian": "allow"
        }
      }
    }
  }
}
