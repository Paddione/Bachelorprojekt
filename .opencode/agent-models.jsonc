{
  "provider": {
    "llamacpp-gemma26": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp b10223 (Gemma4 26B A4B QAT, 3 Slots, unified KV)",
      // Einzige Definitionsstelle dieses Provider-Keys im Repo. scripts/opencode-sync-agents.sh
      // synct sie nach ~/.config/opencode/opencode.jsonc; .opencode/opencode.jsonc darf sie
      // NICHT erneut definieren, sonst driftet der Wert projekt-lokal ab (T002159).
      "options": {
        // T002558: ueber den llm-proxy, NICHT direkt auf :8091. Damit gilt
        // max_inflight=1 auch fuer die opencode-Agenten (sie serialisieren,
        // statt gleichzeitig auf den Server zu gehen), und die Fallback-Kette
        // gemma -> deepseek -> opencode-zen greift auch lokal. Vorher standen
        // die Agenten bei totem Gemma schlicht ohne Modell da.
        "baseURL": "http://127.0.0.1:18235/v1",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "gemma26-factory": {
          "name": "Gemma4 26B A4B QAT (UD-Q4_K_XL), raw llama.cpp b10223 + CUDA 13.3, 3 Slots mit unified KV (-kvu), q4_0 KV, --fit on - Start ueber den llm-proxy: curl -XPOST 127.0.0.1:18235/admin/loadouts/gemma26-factory/start",
          // Der Schluessel ist der ALIAS, unter dem sich der Server in
          // /v1/models meldet - nicht der GGUF-Dateiname. Der Alias bleibt
          // stabil, wenn die Datei einmal getauscht wird.
          //
          // 99840 ist GEMESSEN (curl 127.0.0.1:8091/props, 2026-08-02), nicht
          // n_ctx_train. Vorher stand hier 262144 - der Wert des abgeloesten
          // 12B-Servers, also das 2,6-fache des real Verfuegbaren [T002545].
          //
          // Mit -kvu sieht JEDER der drei Slots diesen vollen Wert; der Puffer
          // ist geteilt, nicht aufgeteilt (gemessen: -c 8192 -np 4 ergibt
          // n_ctx_slot 8192 mit -kvu und 2048 ohne). Drei Agenten koennen ihn
          // aber nicht gleichzeitig ausschoepfen - sie konkurrieren um
          // denselben Speicher.
          "limit": {
            "context": 88832,
            "output": 8192
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      // No models pulled yet (`ollama list` is empty). Add an entry here per
      // model after `ollama pull <model>` - opencode has no model auto-discovery
      // for OpenAI-compatible providers yet (github.com/anomalyco/opencode#6231).
      "models": {}
    },

    // OpenCode Zen/Go: Key aus ~/.config/opencode/secrets.env (chmod 600, nicht
    // in git). "opencode-go" statt "opencode" (Zen) - Subscription-Tier ($10/mo),
    // deepseek-v4-flash ist Teil des Go-Katalogs (verifiziert per curl gegen
    // https://opencode.ai/zen/go/v1/chat/completions, cost:"0" = im Abo enthalten).
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (Subscription, deepseek-v4-flash)",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1",
        "apiKey": "{env:OPENCODE_API_KEY}"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (OpenCode Go, 1M ctx, MoE 284B/13B active)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        }
      }
    },
    "lmstudio": {
      "models": {
        "qwen3.5-9b@q4_k_xl": {
          "name": "Qwen3.5-9B (1 session, 140k ctx, UD-Q4_K_XL weights, Q8_0 KV)",
          "limit": {
            "context": 140000,
            "output": 8192
          }
        },
        "qwen3.5-9b@q4_k_m": {
          "name": "Qwen3.5-9B (3x48k parallel, Q4_K_M weights, Q8_0 KV)",
          "limit": {
            "context": 48000,
            "output": 8192
          }
        },
        "qwen3.5-9b@iq4_xs": {
          "name": "Qwen3.5-9B (4x65k parallel, IQ4_XS weights, 260k total ctx)",
          "limit": {
            "context": 260000,
            "output": 8192
          }
        },
        "qwen3-14b@q4_k_m": {
          "name": "Qwen3-14B (1 session, Q4_K_M, lmstudio-community/Qwen3-14B-GGUF)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "google/gemma-4-12b-qat": {
          "name": "Gemma 4 12B (QAT)",
          "limit": {
            "context": 180000,
            "output": 8192
          }
        },
        "gemma-4-12b-agentic-fable5-composer2.5-v2-3.5x-tau2@q4_k_m": {
          "name": "Gemma4 v2 12B + 423M MTP-Assistant draft (speculative decoding, yuxinlu1, Q4_K_M weights, Q8_0 KV)",
          "limit": {
            "context": 150000,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    // DREI Gemma-Kontexte, passend zu "parallel": 3 im Loadout gemma26-factory
    // [T002545]. Das loest die Begruendung von T002298 ab, ohne sie zu
    // verwerfen: dort waren vier gleich konfigurierte Namen (gemma-4-12b-1..4)
    // auf EINEN Server-Slot gerichtet, und T002286 hatte gemessen, dass
    // mehrere Streams den gemeinsamen System-Prompt jedes Mal neu prefillen.
    // Genau dieser Punkt entfaellt jetzt: mit drei Slots behaelt jeder Agent
    // seinen eigenen KV-Zustand.
    //
    // Was NICHT entfaellt: der llm-proxy hat weiterhin max_inflight=1, die
    // Agenten rechnen also nacheinander. Drei Slots bringen erhaltenen
    // Kontext, nicht Durchsatz — bei einer einzelnen GPU waere echte
    // Nebenlaeufigkeit ohnehin kaum ein Gewinn.
    //
    // "-np" heisst in llama.cpp "number of server slots", nicht
    // "Parallelitaet": ein Slot ist ein Zustandshalter. Wer die drei Namen
    // wieder zusammenstreicht, nimmt jedem Agenten seinen Praefix-Cache.
    "gemma26-1": {
      "description": "Write-capable Gemma subagent on gemma26-factory (Gemma4 26B A4B, llama.cpp :8091, slot 1 of 3, ~99840 ctx). Three such subagents exist so each keeps its own prefix cache; they still execute one at a time because the llm-proxy serializes (max_inflight=1). Preferred for write-capable delegation.",
      "mode": "subagent",
      "model": "llamacpp-gemma26/gemma26-factory",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#34D399",
      "temperature": 0.4,
      "steps": 10,
      // write=deny: subagent überschreibt sonst ganze Dateien statt surgical edit
      // (beobachtet 2026-07-23, T002137: subagents löschten existierende Files).
      // Neue Dateien erzeugt der Orchestrator nach Erhalt des Contents.
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    "gemma26-2": {
      "description": "Second write-capable Gemma subagent on gemma26-factory (slot 2 of 3, ~99840 ctx). Identical configuration to gemma26-1 — the separate name exists so the two keep distinct prefix caches instead of evicting each other.",
      "mode": "subagent",
      "model": "llamacpp-gemma26/gemma26-factory",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#34D399",
      "temperature": 0.4,
      "steps": 10,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    // Primaerer (Tab-waehlbarer) Gemma-Agent, dritter der drei Kontexte.
    // "mode": "primary" heisst: vom Benutzer direkt gewaehlt, NICHT per `task`
    // summonbar.
    //
    // Gedacht fuer Arbeit, die komplett lokal laufen soll, ohne DeepSeek-
    // Orchestrator davor. `task` bewusst nur auf deepseek-helper: wuerde er
    // gemma26-1/-2 dispatchen, laegen mehr als drei Gemma-Kontexte auf drei
    // Slots und wuerden sich gegenseitig verdraengen.
    "gemma26-primary": {
      "description": "Primary (Tab-selectable) Gemma agent on gemma26-factory, slot 3 of 3 (~99840 ctx, measured — not n_ctx_train). Use for fully local work without the DeepSeek orchestrator in front. Can escalate to deepseek-helper but must not dispatch gemma26-1/-2: that would put more than three Gemma contexts on three slots.",
      "mode": "primary",
      "model": "llamacpp-gemma26/gemma26-factory",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#6EE7B7",
      // Zwischen Orchestrator (0.2) und Subagent (0.4): der primaere Agent
      // plant UND implementiert. Deutlich hoehere Werte riskieren den
      // Tool-Call-im-<think>-Block-Fehler aus der fablevibes-Diagnose.
      "temperature": 0.3,
      "steps": 50,
      // write=deny aus demselben Grund wie beim Subagenten - das ist eine
      // Modell-Eigenschaft (Ganzdatei-Overwrite statt Edit), keine Frage des
      // Agent-Modus. Neue Dateien legt der Benutzer bzw. ein Folgeschritt an.
      "permission": {
        "edit": "allow",
        "write": "deny",
        "bash": "allow",
        "task": { "deepseek-helper": "allow", "gemma26-1": "deny", "gemma26-2": "deny" }
      }
    },
    // Eskalationsstufe fuer Parallel-Agenten, NACH lokaler Kontext-
    // Kompaktierung/Retry und opencodes eigener Kompaktierung - erst wenn
    // beides nicht reicht, wird hier dispatcht. Laeuft ueber die OpenCode-
    // Go-Subscription (kein Pay-per-Token, s. "opencode-go"-Provider oben),
    // nicht ueber eine direkte DeepSeek-API-Abrechnung.
    "deepseek-helper": {
      "description": "ESCALATION: DeepSeek V4 Flash via OpenCode Go (1M ctx) - dispatch when a local gemma26 subagent is stuck, needs help, or exhausted its context after local compaction/retry already failed",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F97316",
      "temperature": 0.3,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "orchestrator": {
      "description": "Primary orchestrator: DeepSeek V4 Flash (1M ctx) dispatches the gemma26 subagents sequentially for implementation - the llm-proxy serializes anyway (max_inflight=1). Handles git/workflow/CI checkpoints. Tab-selectable via Tab key.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/orchestrator.md}",
      "color": "#8B5CF6",
      "temperature": 0.2,
      "steps": 50,
      // Exakte Namen statt "gemma26-*" (Prinzip aus T002298): ein Wildcard
      // wuerde jeden neu hinzugefuegten Gemma-Subagenten automatisch
      // mitfreigeben. Ein vierter muss hier bewusst eingetragen werden - und
      // dann faellt auf, dass es nur drei Slots gibt [T002545].
      "permission": {
        "task": {
          "gemma26-1": "allow",
          "gemma26-2": "allow",
          "deepseek-helper": "allow"
        }
      }
    }
  }
}
