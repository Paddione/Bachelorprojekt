{
  "provider": {
    // Lokaler llama.cpp-Provider ueber den llm-proxy.
    //
    // Ersetzt die frueheren Bloecke llamacpp-gemma26 und llamacpp-gemma9 [2026-08-03].
    // Deren Modelle (gemma26-factory, gemma9-factory) sind Loadouts, deren GGUF-Dateien
    // auf diesem Host nicht mehr existieren — von den acht Loadouts in
    // scripts/llm/loadouts.json haben nur noch vier ihre Gewichte. Jeder Dispatch auf
    // die Gemma-Agenten lief damit ins Leere.
    //
    // Weiterhin ueber den llm-proxy (:18235) statt direkt auf den Server-Port: damit gilt
    // max_inflight=1 auch fuer die opencode-Agenten (sie serialisieren, statt gleichzeitig
    // auf die eine GPU zu gehen) und die Fallback-Kette lokal -> deepseek -> zen greift
    // auch hier [T002558].
    "llamacpp-local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "llama.cpp b10225 via llm-proxy (Unsloth-Build, CUDA 13.3)",
      "options": {
        "baseURL": "http://127.0.0.1:18235/v1",
        "timeout": 600000,
        "chunkTimeout": 120000
      },
      "models": {
        "gptoss-context": {
          "name": "gpt-oss-20b Q8_0 (MXFP4-nativ), Loadout gptoss-context auf Port 8098 - Start: curl -XPOST 127.0.0.1:18235/admin/loadouts/gptoss-context/start",
          // 105472 ist GEMESSEN (llama-server meldete n_ctx_slot=105472 beim Laden am
          // 2026-08-03), nicht n_ctx_train. Durchsatz derselbe Lauf: 165 tok/s prompt,
          // 147 tok/s decode.
          "limit": {
            "context": 105472,
            "output": 8192
          }
        },
        "devstral-quality": {
          "name": "Devstral-Small-2 24B IQ4_XS, Loadout devstral-quality auf Port 8099 - teilt sich exclusiveGroup chat-gpu mit gptoss-context, es laeuft immer nur eines",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        // 2026-08-04: Familiensubagenten gemma/qwen brauchen eigene Loadouts.
        // gemma4 (Gemma 4 12B Q4_K_M, 7,1 GB) und qwen3-coder-30b (Qwen3-Coder
        // 30B A3B, 17,6 GB) liegen wieder auf der Platte — die Retire-Migration
        // vom 2026-08-03 kannte sie noch nicht. Ports 8090/8094 frei. Beide
        // teilen exclusiveGroup chat-gpu: es laeuft immer nur eines.
        "gemma4": {
          "name": "Gemma 4 12B Q4_K_M, Loadout gemma4 auf Port 8090 - exclusiveGroup chat-gpu",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "qwen3-coder-30b": {
          "name": "Qwen3-Coder-30B-A3B UD-Q4_K_XL, Loadout qwen3-coder-30b auf Port 8094 - exclusiveGroup chat-gpu",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      // No models pulled yet (`ollama list` is empty). Add an entry here per
      // model after `ollama pull <model>` - opencode has no model auto-discovery
      // for OpenAI-compatible providers yet (github.com/anomalyco/opencode#6231).
      "models": {}
    },

    // OpenCode Zen/Go: "opencode-go" statt "opencode" (Zen) - Subscription-Tier
    // ($10/mo), deepseek-v4-flash ist Teil des Go-Katalogs (verifiziert per curl
    // gegen https://opencode.ai/zen/go/v1/chat/completions, cost:"0" = im Abo
    // enthalten).
    //
    // Kein "apiKey" hier [2026-08-03]: Der Eintrag lautete frueher
    // "{env:OPENCODE_API_KEY}" und verwies auf ~/.config/opencode/secrets.env.
    // Diese Datei existiert nicht und die Variable ist in keiner Shell gesetzt —
    // die Referenz loeste sich also ins Leere auf. Der Schluessel liegt
    // tatsaechlich in ~/.local/share/opencode/auth.json, wo `opencode auth login`
    // ihn ablegt (`opencode auth list` zeigt DeepSeek und OpenCode Go). Ohne
    // apiKey-Feld greift opencode genau dort zu — so haelt es der
    // deepseek-Provider oben ebenfalls.
    "opencode-go": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Go (Subscription)",
      "options": {
        "baseURL": "https://opencode.ai/zen/go/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (OpenCode Go, 1M ctx, MoE 284B/13B active)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        // 2026-08-03: v4-pro ist im Go-Katalog enthalten und antwortet
        // (verifiziert per GET /models UND per chat/completions). Er fehlte
        // hier, weshalb der Tiefen-Subagent unnoetig ueber die direkte API
        // lief, statt das bezahlte Abo zu nutzen.
        //
        // Der Go-Katalog fuehrt weit mehr als diese zwei: minimax-m3,
        // kimi-k3, glm-5.2, qwen3.8-max und andere. Sie sind hier bewusst
        // NICHT eingetragen — jeder Eintrag will gemessen sein, bevor ein
        // Agent darauf zeigt.
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (OpenCode Go, 1M ctx, maximale Reasoning-Tiefe)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    },
    // OpenCode Zen (https://opencode.ai/zen/v1) — der Katalog MIT `big-pickle`,
    // das auf dem Go-Katalog (/zen/go/v1) fehlt. Gleicher Auth-Schluessel wie
    // opencode-go: der Key wird via `opencode auth` unter dem Provider-Namen
    // "opencode-zen" in ~/.local/share/opencode/auth.json gehalten. big-pickle
    // laeuft im Free-Kontingent — bis das verbraucht ist, dann auf die
    // deepseek-Primaries wechseln.
    "opencode-zen": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen (big-pickle, bis Free-Kontingent verbraucht)",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": {
          "name": "Big Pickle (OpenCode Zen, free tier — bis das Free-Kontingent verbraucht ist)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    },
    // Direkte DeepSeek-API als Ausweichweg, wenn OpenCode Go nicht traegt
    // (Abo-Limit, Zen-Ausfall). Key liegt in ~/.local/share/opencode/auth.json
    // unter dem Provider-Schluessel "deepseek" (via `opencode auth`).
    //
    // Warum die IDs hier explizit stehen [2026-08-03, gemessen]:
    // GET https://api.deepseek.com/models fuehrt nur noch deepseek-v4-flash
    // und deepseek-v4-pro. Die frueher konfigurierten deepseek-chat und
    // deepseek-reasoner sind aus der Liste verschwunden — sie ANTWORTEN aber
    // weiterhin (beide per chat/completions gegengeprueft, finish_reason=stop).
    // Es sind also undokumentierte Aliase, kein Totalausfall. Der Wechsel auf
    // V4 erfolgt deshalb nicht als Fehlerbehebung, sondern wegen des
    // Kontextfensters: 1M statt 128K/200K.
    //
    // Beide V4-Modelle sind Reasoning-Modelle und fuellen reasoning_content
    // zusaetzlich zu content. Wer sie mit knappem max_tokens testet, sieht
    // content="" bei finish_reason="length" — das Budget ging fuers Denken
    // drauf und ist KEIN Fehler des Modells.
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek (direkte API, Ausweichweg zu OpenCode Go)",
      "options": {
        "baseURL": "https://api.deepseek.com/v1"
      },
      "models": {
        "deepseek-v4-flash": {
          "name": "DeepSeek V4 Flash (direkte API)",
          "limit": {
            "context": 1000000,
            "output": 8192
          }
        },
        "deepseek-v4-pro": {
          "name": "DeepSeek V4 Pro (direkte API, maximale Reasoning-Tiefe)",
          "limit": {
            "context": 1000000,
            "output": 16384
          }
        }
      }
    },
    "lmstudio": {
      "models": {
        "qwen3.5-9b@q4_k_xl": {
          "name": "Qwen3.5-9B (1 session, 140k ctx, UD-Q4_K_XL weights, Q8_0 KV)",
          "limit": {
            "context": 140000,
            "output": 8192
          }
        },
        "qwen3.5-9b@q4_k_m": {
          "name": "Qwen3.5-9B (3x48k parallel, Q4_K_M weights, Q8_0 KV)",
          "limit": {
            "context": 48000,
            "output": 8192
          }
        },
        "qwen3.5-9b@iq4_xs": {
          "name": "Qwen3.5-9B (4x65k parallel, IQ4_XS weights, 260k total ctx)",
          "limit": {
            "context": 260000,
            "output": 8192
          }
        },
        "qwen3-14b@q4_k_m": {
          "name": "Qwen3-14B (1 session, Q4_K_M, lmstudio-community/Qwen3-14B-GGUF)",
          "limit": {
            "context": 32768,
            "output": 8192
          }
        },
        "google/gemma-4-12b-qat": {
          "name": "Gemma 4 12B (QAT)",
          "limit": {
            "context": 180000,
            "output": 8192
          }
        },
        "gemma-4-12b-agentic-fable5-composer2.5-v2-3.5x-tau2@q4_k_m": {
          "name": "Gemma4 v2 12B + 423M MTP-Assistant draft (speculative decoding, yuxinlu1, Q4_K_M weights, Q8_0 KV)",
          "limit": {
            "context": 150000,
            "output": 8192
          }
        }
      }
    }
  },
  "agent": {
    // LOKALE SUBAGENTEN NACH MODELL-FAMILIE [2026-08-04].
    //
    // Frueher hiessen sie gemma26-1/2 und gemma9-1/2 und zeigten ALLE auf
    // gptoss-context — der Name log ueber das Modell. Seit 2026-08-04 traegt
    // jeder lokale Subagent den Namen der Familie, die er tatsaechlich serviert
    // (gptoss, devstral, gemma, qwen), und der Orchestrator ruft ihn damit auf:
    // `task gemma` gibt die Gemma-Familie, `task qwen` die Qwen-Familie.
    //
    // Was unveraendert gilt: der llm-proxy hat max_inflight=1, die Agenten
    // rechnen nacheinander. Mehr Namen bringen erhaltenen Kontext, nicht
    // Durchsatz — bei einer einzelnen GPU waere echte Nebenlaeufigkeit ohnehin
    // kaum ein Gewinn. Alle vier Chat-Loadouts teilen exclusiveGroup
    // "chat-gpu": es laeuft immer nur eines.
    //
    // Der urspruengliche Hinweis aus T002298 bleibt gueltig: "-np" heisst in
    // llama.cpp "number of server slots", nicht "Parallelitaet". Wer die Namen
    // zusammenstreicht, nimmt jedem Agenten seinen Praefix-Cache.
    "gptoss": {
      "description": "Local subagent for the gpt-oss family (gpt-oss-20b Q8_0, 105472 ctx measured, via llm-proxy :18235). Write-capable delegation; executes one at a time because the proxy serializes (max_inflight=1).",
      "mode": "subagent",
      "model": "llamacpp-local/gptoss-context",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#34D399",
      "temperature": 0.4,
      "steps": 50,
      // write=deny: subagent überschreibt sonst ganze Dateien statt surgical edit
      // (beobachtet 2026-07-23, T002137: subagents löschten existierende Files).
      // Neue Dateien erzeugt der Orchestrator nach Erhalt des Contents.
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    "devstral": {
      "description": "Local subagent for the devstral family (Devstral-Small-2-24B IQ4_XS, via llm-proxy :18235). Write-capable delegation; shares exclusiveGroup chat-gpu with the other local loadouts (only one runs at a time).",
      "mode": "subagent",
      "model": "llamacpp-local/devstral-quality",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#60A5FA",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    "gemma": {
      "description": "Local subagent for the gemma family (Gemma 4 12B Q4_K_M, Loadout gemma4 auf Port 8090, via llm-proxy :18235). Write-capable delegation; shares exclusiveGroup chat-gpu.",
      "mode": "subagent",
      "model": "llamacpp-local/gemma4",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#F59E0B",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    "qwen": {
      "description": "Local subagent for the qwen family (Qwen3-Coder-30B-A3B UD-Q4_K_XL, Loadout qwen3-coder-30b auf Port 8094, via llm-proxy :18235). Write-capable delegation; shares exclusiveGroup chat-gpu.",
      "mode": "subagent",
      "model": "llamacpp-local/qwen3-coder-30b",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#A78BFA",
      "temperature": 0.4,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "deny" }
    },
    // Primaerer (Tab-waehlbarer) Lokal-Agent auf gptoss-context.
    // "mode": "primary" heisst: vom Benutzer direkt gewaehlt, NICHT per `task`
    // summonbar.
    //
    // Gedacht fuer Arbeit, die komplett lokal laufen soll, ohne DeepSeek-
    // Orchestrator davor. `task` bewusst nur auf deepseek-helper: wuerde er die
    // lokalen Familiensubagenten (gptoss/devstral/gemma/qwen) dispatchen,
    // laegen mehrere Kontexte auf einer GPU und wuerden sich gegenseitig
    // verdraengen.
    "gemma26-primary": {
      "description": "Primary (Tab-selectable) local agent on gptoss-context (gpt-oss-20b, 105472 ctx). Use for fully local work without the DeepSeek orchestrator in front. Can escalate to the deepseek subagents but must not dispatch the local subagents: with one GPU they would only contend for the same weights.",
      "mode": "primary",
      "model": "llamacpp-local/gptoss-context",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#6EE7B7",
      // Zwischen Orchestrator (0.2) und Subagent (0.4): der primaere Agent
      // plant UND implementiert. Deutlich hoehere Werte riskieren den
      // Tool-Call-im-<think>-Block-Fehler aus der fablevibes-Diagnose.
      "temperature": 0.3,
      "steps": 50,
      // write=deny aus demselben Grund wie beim Subagenten - das ist eine
      // Modell-Eigenschaft (Ganzdatei-Overwrite statt Edit), keine Frage des
      // Agent-Modus. Neue Dateien legt der Benutzer bzw. ein Folgeschritt an.
      "permission": {
        "edit": "allow",
        "write": "deny",
        "bash": "allow",
        "task": { "deepseek-helper": "allow", "deepseek-pro": "allow", "deepseek-flash": "allow", "gptoss": "deny", "devstral": "deny", "gemma": "deny", "qwen": "deny" }
      }
    },
    // Maximaler lokaler Kontext (105472, gemessen beim Laden am 2026-08-03).
    // Keinerlei Subagent-Dispatch — rein lokale Arbeit ohne Netzanbindung.
    //
    // Vision ist trotz des Namens NICHT verfuegbar: gpt-oss-20b bringt kein
    // mmproj mit. Der Name stammt aus der Gemma-Zeit, als ein 12B-Loadout eines
    // hatte. Wird ein vision-faehiges lokales Modell geladen, erkennt opencode
    // das automatisch — bis dahin ist dieser Agent text-only.
    "gemma26-vision": {
      "description": "Local agent on gptoss-context with no subagent dispatch \u2014 for long-context work that must stay on-device. Vision is NOT available: gpt-oss-20b has no mmproj, so this agent is text-only until a vision-capable local model is loaded.",
      "mode": "primary",
      "model": "llamacpp-local/gptoss-context",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#A78BFA",
      "temperature": 0.3,
      "steps": 50,
      "permission": {
        "edit": "allow",
        "write": "deny",
        "bash": "allow",
        "task": "deny"
      }
    },
    // Eskalationsstufe fuer Parallel-Agenten, NACH lokaler Kontext-
    // Kompaktierung/Retry und opencodes eigener Kompaktierung - erst wenn
    // beides nicht reicht, wird hier dispatcht. Verwendet die direkte
    // DeepSeek-API (deepseek-chat / V3) fuer schnelle Hilfestellung.
    "deepseek-helper": {
      "description": "ESCALATION: DeepSeek V4 Flash via the direct DeepSeek API (1M ctx) — dispatch when a local subagent is stuck, needs help, or exhausted its context after local compaction/retry already failed. Uses the direct API rather than OpenCode Go on purpose: this is the fallback path, so it stays usable when the Go subscription is exhausted or Zen is down.",
      "mode": "subagent",
      // War deepseek/deepseek-chat (V3, 128K). Gewechselt wegen des
      // Kontextfensters, nicht wegen eines Fehlers — die alte ID antwortet
      // weiterhin, ist aber nicht mehr in /models gelistet [2026-08-03].
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F97316",
      "temperature": 0.3,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Tiefer Analyse-Agent: DeepSeek-R1 mit maximaler Reasoning-Tiefe fuer
    // komplexe Architektur-Debugging, mehrschrittiges Reasoning und harte
    // Multi-File-Refactorings, die ueber das hinausgehen, was deepseek-helper
    // schnell loesen kann.
    "deepseek-pro": {
      "description": "DEPTH: DeepSeek V4 Pro via OpenCode Go (1M ctx, maximum reasoning effort). Use for deep analysis, complex multi-file debugging, architectural reasoning, or hard refactors that exceed what deepseek-flash can handle. Dispatch ONE at a time — this is the expensive, slow tier. If Go is unavailable, use deepseek-pro-direct. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      // War deepseek/deepseek-reasoner (R1, 128K). Gewechselt auf V4 Pro
      // wegen 1M Kontext; Primaerweg ist jetzt Go (im Abo enthalten) statt
      // der direkten API [2026-08-03].
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#EF4444",
      "temperature": 0.1,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Ausweich-Zwilling von deepseek-pro auf der direkten API. opencode kennt
    // kein Provider-Failover pro Agent — ein zweiter Agentname ist der
    // einzige Weg, denselben Auftrag ueber den anderen Anbieter zu fahren.
    "deepseek-pro-direct": {
      "description": "FALLBACK twin of deepseek-pro on the direct DeepSeek API (1M ctx). Identical role and prompt — dispatch this instead of deepseek-pro when OpenCode Go is exhausted, rate-limited, or down. Not a second parallel slot: it is the same tier via another route. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#EF4444",
      "temperature": 0.1,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Schneller Parallel-Dispatcher: DeepSeek-V3 mit maximalem Reasoning-
    // Effort, bis zu 3 Instanzen gleichzeitig (je 200K ctx). Gedacht fuer
    // unabhaengige Teilaufgaben, die parallel abgearbeitet werden koennen.
    "deepseek-flash": {
      "description": "THROUGHPUT: DeepSeek V4 Flash via OpenCode Go (1M ctx). Dispatch up to 3 at a time for independent parallel subtasks — each gets its own context window, and remote models do not contend for the single local GPU. Faster and cheaper than deepseek-pro; use for breadth, not depth. Default choice when no local model is loaded. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      // War deepseek/deepseek-chat (V3, 200K). Auf V4 Flash wegen 1M
      // Kontext; Primaerweg ist jetzt Go [2026-08-03].
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F59E0B",
      "temperature": 0.2,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "deepseek-flash-direct": {
      "description": "FALLBACK twin of deepseek-flash on the direct DeepSeek API (1M ctx). Same role and prompt — dispatch when OpenCode Go is exhausted, rate-limited, or down. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F59E0B",
      "temperature": 0.2,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "orchestrator": {
      "description": "Primary orchestrator: DeepSeek V4 Flash (1M ctx) dispatches the local family subagents (gptoss/devstral/gemma/qwen) sequentially for implementation - the llm-proxy serializes anyway (max_inflight=1). Handles git/workflow/CI checkpoints. Tab-selectable via Tab key.",
      "mode": "primary",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/orchestrator.md}",
      "color": "#8B5CF6",
      "temperature": 0.2,
      "steps": 150,
      // Exakte Namen statt "gemma26-*" (Prinzip aus T002298): ein Wildcard
      // wuerde jeden neu hinzugefuegten Subagenten automatisch mitfreigeben.
      "permission": {
        "task": {
          "gptoss": "allow",
          "devstral": "allow",
          "gemma": "allow",
          "qwen": "allow",
          "deepseek-helper": "allow",
          "deepseek-pro": "allow",
          "deepseek-flash": "allow",
          // Ausweich-Zwillinge auf der direkten API. Bewusst freigegeben, aber
          // als Ausweichweg gedacht: erst Go, bei Ausfall diese. Der
          // Orchestrator-Prompt beschreibt, wann.
          "deepseek-pro-direct": "allow",
          "deepseek-flash-direct": "allow"
        }
      }
    },
    // Big Pickle auf OpenCode Zen — als primaerer (Tab-waehlbarer) Agent bis das
    // Free-Kontingent verbraucht ist, danach auf die deepseek-Primaries wechseln.
    "big-pickle": {
      "description": "PRIMARY: Big Pickle on OpenCode Zen (free tier). Tab-selectable singleagent model — use it while the free Zen quota lasts, then switch to the deepseek-pro/flash primaries. Runs through the zen gateway (opencode-zen/big-pickle), not the Go catalog.",
      "mode": "primary",
      "model": "opencode-zen/big-pickle",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#F472B6",
      "temperature": 0.2,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    }
  }
}
