    "gemma26-throughput-primary": {
      "description": "PRIMARY: modellagnostisch auf FreeToken-native (:1919, Alias 'active' = residentes Modell). Tab-selectable singleagent on the freetoken-local provider. Text-only. Can dispatch subagents.",
      "mode": "primary",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#FBBF24",
      "temperature": 0.3,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "allow" }
    },
    "qwen38-primary": {
      "description": "PRIMARY: modellagnostisch auf FreeToken-native (:1919, Alias 'active' = residentes Modell). Tab-selectable text-only singleagent on the freetoken-local provider. Can dispatch any subagent.",
      "mode": "primary",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#A855F7",
      "temperature": 0.3,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "allow" }
    },
    // T014105: aus der Global-Config (T014028) nachgetragen — dedizierter
    // Tab-waehlbarer Primary auf dem FreeToken-Alias, damit der lokale Stack
    // auch ohne Familien-Namen direkt waehlbar bleibt.
    "freetoken-primary": {
      "description": "PRIMARY: modellagnostisch auf FreeToken-native (:1919) — Alias 'active' serviert immer das gerade residente Modell (Qwen ~104 tok/s kurz / gpt-oss ~112 / Gemma ~73; Plugin freetoken-active setzt das Kontext-Limit beim Start). Tab-selectable singleagent, text-only. Can dispatch subagents.",
      "mode": "primary",
      "model": "freetoken-local/active",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#22D3EE",
      "temperature": 0.3,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "allow" }
    },
    // Eskalationsstufe fuer Parallel-Agenten, NACH lokaler Kontext-
    // Kompaktierung/Retry und opencodes eigener Kompaktierung - erst wenn
    // beides nicht reicht, wird hier dispatcht. Verwendet die direkte
    // DeepSeek-API (deepseek-chat / V3) fuer schnelle Hilfestellung.
    "deepseek-helper": {
      "description": "ESCALATION: DeepSeek V4 Flash via the direct DeepSeek API (1M ctx) — dispatch when a local subagent is stuck, needs help, or exhausted its context after local compaction/retry already failed. Uses the direct API rather than OpenCode Go on purpose: this is the fallback path, so it stays usable when the Go subscription is exhausted or Zen is down.",
      "mode": "subagent",
      // War deepseek/deepseek-chat (V3, 128K). Gewechselt wegen des
      // Kontextfensters, nicht wegen eines Fehlers — die alte ID antwortet
      // weiterhin, ist aber nicht mehr in /models gelistet [2026-08-03].
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F97316",
      "temperature": 0.3,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // 2026-08-22: Ausweich-Zwilling von deepseek-helper ueber OpenCode Go.
    // deepseek-helper laeuft bewusst auf der direkten API (Fallback-Pfad);
    // damit ist die Helper-Stufe jetzt MEHRGLEISIG: direkt (deepseek-helper)
    // UND Go (deepseek-helper-go) — dieselbe Logik wie beim pro/flash-Paar.
    // Dritte Schiene (Alibaba Token Plan): am 2026-08-22 erst VERWORFEN
    // (gespeicherter Key lieferte "InvalidApiKey"), nach Key-Rotation am selben
    // Tag erfolgreich nachgemessen — siehe deepseek-helper-alibaba /
    // deepseek-pro-alibaba unten.
    "deepseek-helper-go": {
      "description": "ESCALATION twin of deepseek-helper via OpenCode Go (DeepSeek V4 Flash, 1M ctx). Same role and prompt as deepseek-helper (which uses the direct API on purpose) — dispatch this route when the direct API is down or rate-limited. Mode subagent: escalation-only, not tab-selectable.",
      "mode": "subagent",
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F97316",
      "temperature": 0.3,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // 2026-08-22: dritte Helper-Schiene ueber den Alibaba Token Plan, nach
    // Key-Rotation gemessen (Model-ID: deepseek-v4-flash-0731 — abweichend von
    // der direkten API; Smoke-Test antwortete). Damit ist die Helper-Stufe
    // dreigleisig: direkt (deepseek-helper), Go (deepseek-helper-go),
    // Alibaba (deepseek-helper-alibaba).
    "deepseek-helper-alibaba": {
      "description": "ESCALATION twin of deepseek-helper via the Alibaba Cloud Intl Token Plan (DeepSeek V4 Flash 0731). Same role and prompt — third route when both the direct DeepSeek API and OpenCode Go fail. Mode subagent: escalation-only, not tab-selectable.",
      "mode": "subagent",
      "model": "alibaba-intl/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F97316",
      "temperature": 0.3,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Tiefer Analyse-Agent: DeepSeek-R1 mit maximaler Reasoning-Tiefe fuer
    // komplexe Architektur-Debugging, mehrschrittiges Reasoning und harte
    // Multi-File-Refactorings, die ueber das hinausgehen, was deepseek-helper
    // schnell loesen kann.
    "deepseek-pro": {
      "description": "DEPTH: DeepSeek V4 Pro via OpenCode Go (1M ctx, maximum reasoning effort). Use for deep analysis, complex multi-file debugging, architectural reasoning, or hard refactors that exceed what deepseek-flash can handle. Dispatch ONE at a time — this is the expensive, slow tier. If Go is unavailable, use deepseek-pro-direct. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      // War deepseek/deepseek-reasoner (R1, 128K). Gewechselt auf V4 Pro
      // wegen 1M Kontext; Primaerweg ist jetzt Go (im Abo enthalten) statt
      // der direkten API [2026-08-03].
      "model": "opencode-go/deepseek-v4-pro",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#EF4444",
      "temperature": 0.1,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Ausweich-Zwilling von deepseek-pro auf der direkten API. opencode kennt
    // kein Provider-Failover pro Agent — ein zweiter Agentname ist der
    // einzige Weg, denselben Auftrag ueber den anderen Anbieter zu fahren.
    "deepseek-pro-direct": {
      "description": "FALLBACK twin of deepseek-pro on the direct DeepSeek API (1M ctx). Identical role and prompt — dispatch this instead of deepseek-pro when OpenCode Go is exhausted, rate-limited, or down. Not a second parallel slot: it is the same tier via another route. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-pro",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#EF4444",
      "temperature": 0.1,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // 2026-08-22: dritte Pro-Schiene ueber den Alibaba Token Plan, nach
    // Key-Rotation gemessen (Smoke-Test: "OK", finish=stop). Damit ist die
    // Pro-Stufe dreigleisig: Go (deepseek-pro), direkt (deepseek-pro-direct),
    // Alibaba (deepseek-pro-alibaba).
    "deepseek-pro-alibaba": {
      "description": "FALLBACK twin of deepseek-pro via the Alibaba Cloud Intl Token Plan (DeepSeek V4 Pro). Same role and prompt — third route when both OpenCode Go and the direct API fail. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      "model": "alibaba-intl/deepseek-v4-pro",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#EF4444",
      "temperature": 0.1,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    // Schneller Parallel-Dispatcher: DeepSeek-V3 mit maximalem Reasoning-
    // Effort, bis zu 3 Instanzen gleichzeitig (je 200K ctx). Gedacht fuer
    // unabhaengige Teilaufgaben, die parallel abgearbeitet werden koennen.
    "deepseek-flash": {
      "description": "THROUGHPUT: DeepSeek V4 Flash via OpenCode Go (1M ctx). Dispatch up to 3 at a time for independent parallel subtasks — each gets its own context window, and remote models do not contend for the single local GPU. Faster and cheaper than deepseek-pro; use for breadth, not depth. Default choice when no local model is loaded. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      // War deepseek/deepseek-chat (V3, 200K). Auf V4 Flash wegen 1M
      // Kontext; Primaerweg ist jetzt Go [2026-08-03].
      "model": "opencode-go/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F59E0B",
      "temperature": 0.2,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "deepseek-flash-direct": {
      "description": "FALLBACK twin of deepseek-flash on the direct DeepSeek API (1M ctx). Same role and prompt — dispatch when OpenCode Go is exhausted, rate-limited, or down. Mode all: tab-selectable AND task-dispatchable.",
      "mode": "all",
      "model": "deepseek/deepseek-v4-flash",
      "prompt": "{file:./prompts/deepseek-helper.md}",
      "color": "#F59E0B",
      "temperature": 0.2,
      "steps": 150,
      "permission": { "edit": "allow", "write": "allow", "bash": "allow", "task": "deny", "webfetch": "deny", "websearch": "deny" }
    },
    "orchestrator": {
      // 2026-08-22 (zweiter Wechsel am selben Tag): von alibaba-intl/qwen3.8-max
      // auf opencode-zen/laguna-s-2.1-free (Poolside agentic coding model,
      // Free-Tier, models.dev: 256k ctx, live gegen chat/completions gemessen —
      // siehe Provider-Kommentar oben). Motivation: der Factory-Executor
      // (opencode-exec.sh) faehrt denselben Agenten — damit laufen Orchestrierung
      // UND Factory-Ticks im Free-Kontingent statt auf dem Alibaba Token Plan.
      // Vorheriger Stand: alibaba-intl/qwen3.8-max (Cloud, 131k ctx), davor
      // llamacpp-local/gemma12-vision (12B lokal).
      "description": "Primary orchestrator: Laguna S 2.1 Free via OpenCode Zen (Poolside agentic coding model, free tier, 256k ctx per models.dev). Dispatches local family subagents (gptoss/devstral/gemma/gemma12/qwen38) and cloud escalation (qwen-cloud/deepseek-*). Also drives the factory executor (opencode-exec.sh runs --agent orchestrator). Tab-selectable via Tab key.",
      "mode": "primary",
      "model": "opencode-zen/laguna-s-2.1-free",
      "prompt": "{file:./prompts/orchestrator.md}",
      "color": "#8B5CF6",
      "temperature": 0.2,
      "steps": 150,
      // Exakte Namen statt "gemma26-*" (Prinzip aus T002298): ein Wildcard
      // wuerde jeden neu hinzugefuegten Subagenten automatisch mitfreigeben.
      "permission": {
        "task": {
          "gptoss": "allow",
          "devstral": "allow",
          "gemma": "allow",
          // T003204: ohne diesen Eintrag existierte der Subagent, waere aber
          // nicht dispatchbar — die Liste nennt bewusst exakte Namen statt einer
          // Wildcard (Prinzip aus T002298).
          "gemma12": "allow",
          // 2026-08-22: fuenfte lokale Familie — Qwen 3.8 27B auf dem
          // qwen38-220k-Loadout (Port 8094, np=1). Nur sequenziell dispatchen.
          "qwen38": "allow",
          // 2026-08-22: Qwen 3.8 Max via Alibaba Cloud — erste Eskalationsstufe
          // nach lokal, selbe Modell-Familie wie der Orchestrator selbst.
          "qwen-cloud": "allow",
          "deepseek-helper": "allow",
          // 2026-08-22: Go-route twin of deepseek-helper (direct API stays the
          // default escalation path; this is the alternate rail).
          "deepseek-helper-go": "allow",
          // 2026-08-22: Alibaba-Token-Plan-Routen (nach Key-Rotation gemessen):
          // dritte Schiene fuer Helper und Pro.
          "deepseek-helper-alibaba": "allow",
          "deepseek-pro": "allow",
          "deepseek-flash": "allow",
          // Ausweich-Zwillinge auf der direkten API. Bewusst freigegeben, aber
          // als Ausweichweg gedacht: erst Go, bei Ausfall diese. Der
          // Orchestrator-Prompt beschreibt, wann.
          "deepseek-pro-direct": "allow",
          "deepseek-flash-direct": "allow",
          "deepseek-pro-alibaba": "allow"
        }
      }
    },
    // ── Alibaba Cloud International (Token Plan) ───────────────────────
    // PRIMARY: Qwen3.8-Max via Alibaba Intl Token Plan — replaces deepseek-v4-flash
    // as the top-level orchestrator model until/unless replaced by something else.
    "alibaba-primary": {
      "description": "PRIMARY: Qwen3.8 Max on Alibaba Cloud Intl Token Plan (131072 ctx). Tab-selectable singleagent — replaces opencode-go/deepseek-v4-flash as the default. Runs through token-plan endpoint (compatible-mode OpenAI format). Can dispatch any subagent.",
      "mode": "primary",
      "model": "alibaba-intl/qwen3.8-max",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#FF6900",
      "temperature": 0.3,
      "steps": 50,
      "permission": { "edit": "allow", "write": "deny", "bash": "allow", "task": "allow" }
    },
    // Big Pickle auf OpenCode Zen — als primaerer (Tab-waehlbarer) Agent bis das
    // Free-Kontingent verbraucht ist, danach auf die deepseek-Primaries wechseln.
    //
    // 2026-08-22: task von "deny" auf dieselbe benannte Allow-Liste wie der
    // Orchestrator umgestellt (Prinzip T002298: exakte Namen statt Wildcard) —
    // Big Pickle kann damit dieselben Subagenten dispatchen wie der Orchestrator
    // bzw. qwen-cloud-Eskalation (lokale Familien + Cloud-Eskalation).
    "big-pickle": {
      "description": "PRIMARY: Big Pickle on OpenCode Zen (free tier). Tab-selectable singleagent model — use it while the free Zen quota lasts, then switch to the deepseek-pro/flash primaries. Runs through the zen gateway (opencode-zen/big-pickle), not the Go catalog. Can dispatch the same subagent set as the orchestrator.",
      "mode": "primary",
      "model": "opencode-zen/big-pickle",
      "prompt": "{file:./prompts/local-subagent.md}",
      "color": "#F472B6",
      "temperature": 0.2,
      "steps": 150,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "gptoss": "allow",
          "devstral": "allow",
          "gemma": "allow",
          "gemma12": "allow",
          "qwen38": "allow",
          "qwen-cloud": "allow",
          "deepseek-helper": "allow",
          "deepseek-helper-go": "allow",
          "deepseek-helper-alibaba": "allow",
          "deepseek-pro": "allow",
          "deepseek-flash": "allow",
          "deepseek-pro-direct": "allow",
          "deepseek-flash-direct": "allow",
          "deepseek-pro-alibaba": "allow"
        }
      }
    },
    // Ox Alpha Free — zweiter Free-Tier-Primary neben Big Pickle [2026-08-22].
    // Zeigt auf opencode-zen/laguna-s-2.1-free (live gegen chat/completions
    // gemessen, siehe Kommentar beim Provider oben).
    //
    // 2026-08-23: Task-Allow-Liste eingedampft auf den ox-alpha-Familien-
    // Subagenten (Prinzip T002298: exakte Namen statt Wildcard) — dieser
    // Primary dispatcht ausschliesslich ox-alpha, keine lokalen Familien,
    // kein qwen-cloud, keine deepseek-*.
    "ox-alpha-free": {
      "description": "PRIMARY: Ox Alpha Free on OpenCode Zen (laguna-s-2.1-free, Poolside agentic coding model, free tier, 256k ctx per models.dev). Tab-selectable singleagent next to big-pickle. Live-smoke-tested 2026-08-22. Dispatches ONLY ox-alpha subagents.",
      "mode": "primary",
      "model": "opencode-zen/laguna-s-2.1-free",
      "prompt": "{file:./prompts/primary-agent.md}",
      "color": "#38BDF8",
      "temperature": 0.2,
      "steps": 150,
      "permission": {
        "edit": "allow",
        "write": "allow",
        "bash": "allow",
        "webfetch": "deny",
        "websearch": "deny",
        "task": {
          "ox-alpha": "allow"
        }
      }
    },
    // Ox Alpha Familien-Subagent [2026-08-23] — einziger Dispatch-Tuer von
    // ox-alpha-free. Dasselbe Modell wie der Primary (laguna-s-2.1-free via
    // OpenCode Zen), derselbe Helper-Prompt wie die anderen Cloud-Subagenten.
    "ox-alpha": {
      "description": "Subagent twin of ox-alpha-free on OpenCode Zen (same laguna-s-2.1-free model, Poolside agentic coding model, free tier). Sole dispatch target of ox-alpha-free — keeps parallel/specialized work inside the same free-tier model family. Write-capable.",
      "mode": "subagent",
      "model": "opencode-zen/laguna-s-2.1-free",
