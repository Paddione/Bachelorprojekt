{
  "$schema": "https://raw.githubusercontent.com/Opencode-DCP/opencode-dynamic-context-pruning/master/dcp.schema.json",
  // ── DCP-Compress-Kalibrierung pro Modellfenster (T900182, T900350) ────────
  // DCP schneidet chirurgisch, die V2-Compaction (opencode.jsonc) bleibt das
  // letzte Sicherheitsnetz. Jede Obergrenze liegt deshalb UNTER dem
  // Compaction-Trigger des jeweiligen Modells — darueber waere sie tote
  // Konfiguration, weil die Compaction zuerst feuert.
  "compress": {
    // Globale Werte = Cloud-Modelle (1M-Fenster, Compaction erst bei
    // ~870k–966k). Sie halten Orchestrator und Cloud-Primaries im
    // Arbeitsband 60–100k: Nudge ab 85k, Zwang ab 103k.
    "minContextLimit": 85000,
    "maxContextLimit": 103000,
    // Lokaler Qwen3.8-27B GSQ-RCO (153600 served KV, Compaction bei 120000).
    // Prozentwerte beziehen sich auf limit.context und wandern mit, wenn das
    // served KV neu gemessen und im Katalog angepasst wird:
    //   40 % = 61440  → Nudge, bevor der Decode deutlich unter ~96 tok/s faellt
    //   75 % = 115200 → Zwang, 4800 unter dem Compaction-Trigger
    "modelMinLimits": {
      "llamacpp-local/Qwen3.8-27B-gsq": "40%"
    },
    "modelMaxLimits": {
      "llamacpp-local/Qwen3.8-27B-gsq": "75%"
    },
    // "soft": Nudge verwendet sanften Hinweis statt Erzwang, um JSON-Parse-Schleifen
    // bei fehlerhaften LLM-Antworten während der Kompaktierung zu verhindern.
    "nudgeForce": "soft",
    // Frequenz: alle 5 Vorgänge ein Nudge — bei Bedarf empirisch auf 3 senken.
    "nudgeFrequency": 5
  },
  // DCP ueberspringt Sessions mit parentID (Subagents) per Default
  // (experimental.allowSubAgents=false). Der lokale `local`-Subagent laeuft
  // aber genau dort in die Laenge — ohne diesen Schalter bekam er weder den
  // 40-%-Nudge noch den 75-%-Zwang und lief bis zur Compaction (T900362).
  "experimental": {
    "allowSubAgents": true
  }
}
