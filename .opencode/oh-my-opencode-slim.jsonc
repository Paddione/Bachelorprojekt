    },
    "librarian": {
      "model": "llamacpp-qwen35/Qwen3.5-4B-MTP"
    },
    "fixer": {
      "model": "llamacpp-local/Qwen3.8-27B"
    },
    "oracle": {
      "model": "llamacpp-local/Qwen3.8-27B"
    },
    "designer": {
      "model": "llamacpp-local/Qwen3.8-27B"
    }
  }
}
