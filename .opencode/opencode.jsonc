{
  "$schema": "https://opencode.ai/config.json",
  // Default = FreeToken-Alias `active`: serviert immer das residente Modell auf
  // pk-desktop (:1919); Kontext-Limit setzt beim Start das Plugin
  // `plugin/freetoken-active.ts` auf die gemessenen KV-Werte. Der alte
  // llama.cpp-Stack (:18235) ist stillgelegt — Default darauf waere ein toter
  // Backend-Aufruf (T016419).
  //
  // Fallback-Kette bleibt: bei Ausfall des lokalen Servers greifen die
  // deepseek-*-Agenten (direkte API, nicht ueber den Proxy).
  "model": "freetoken-local/active",
  // ── Third-party opencode plugins (installed via npm into .opencode/) ──────
  // Loaded from npm through the `plugin` array. Packages are declared in
  // .opencode/package.json. Composio + Firecrawl are MCP servers (see `mcp`
  // below), not opencode plugins.
  "plugin": [
    // Dynamic Context Pruning
    "@tarquinen/opencode-dcp",
    // Envsitter Guard (.env secret leak guard)
    "envsitter-guard",
    // NOTE: @devcxl/opencode-worktree DROPPED — broken as published (missing
    // dist/server.js) AND clashes with the pre-existing dev-flow worktree
    // plugin (.opencode/skills/dev-flow/worktree.ts): both register the same
    // tools worktree_create/worktree_delete. The repo's own plugin is kept.
    // Agent Memory (Letta-style memory blocks)
    "opencode-agent-memory",
    // Oh My OpenCode / OmO Slim (multi-agent)
    "oh-my-opencode-slim",
    // superpowers (T900056): opencode does NOT inherit Claude Code's plugin
    // set -- each harness declares its own. See the upstream install notes at
    // https://github.com/obra/superpowers/blob/main/.opencode/INSTALL.md.
    // Pinned to the same commit as .opencode/package.json (verified against
    // `git ls-remote` and the gitCommitSha Claude Code recorded for its own
    // install of this plugin) -- an unpinned git ref would resolve to
    // whatever is on upstream main at install time, defeating the
    // reproducibility this ticket exists to restore. INSTALL.md documents
    // the `#<ref>` pin syntax directly (its example pins to a tag; a commit
    // SHA is immutable where a tag can move, so that's used here instead).
    "superpowers@git+https://github.com/obra/superpowers.git#b36e0829c6d0140e93cfef2ca599b1b07d4a7797"
  ],
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "deny",
    "skill": {
      "*": "allow",
      // ── Claude Code stubs (opencode has native equivalents) ──────────
      // T013724: dev-flow-plan/-execute/-chore sind KEINE Stubs — es sind die
      // Shared Sources, die opencode seit T014086 unter denselben Namen wie
      // Claude Code lädt (Directory-Symlinks .opencode/skills/dev-flow-*).
      "dev-flow-e2e": "deny",
      // T900056: writing-plans/executing-plans are called as SUB-steps by
      // dev-flow-plan/dev-flow-execute. Allowing them as an entry point would
      // let a repo work request skip ticket creation, worktree setup,
      // plan-lint and stage-plan -- deny direct entry, dev-flow-* still
      // reaches them internally as skill invocations.
      "writing-plans": "deny",
      "executing-plans": "deny",
      // ── Generic meta / skill discovery ───────────────────────────────
      "agent-orchestration": "deny",
      "project-overview": "deny",
      "find-skills": "deny",
      "skill-creator": "deny",
      "codebase-memory": "deny",
      // ── Domain specialists (dispatched via agent routing, not skills) ─
      "database-specialist": "deny",
      "incident-response": "deny",
      "infra-ops": "deny",
      "operations-management": "deny",
      "security-specialist": "deny",
      "website-specialist": "deny",
      // ── UI/design (not primary workflow) ─────────────────────────────
      "ui-ux-pro-max": "deny",
      // T900056: references was denied here, cutting opencode off from
      // dev-flow-plan-phases.md / plan-quality-gates.md / plan-intel-bundle.md
      // -- the normative core the shared dev-flow-* skills depend on. Left
      // allowed (falls through to the "*": "allow" default).
      // ── market-cli installed (not project-relevant, avoid context bloat) ─
      "lavish": "deny"
    }
  },
  "lsp": true,
  // Der Provider "llamacpp-mtp" wird bewusst NICHT hier definiert, sondern
  // ausschliesslich in .opencode/agent-models.jsonc — von dort synct
  // scripts/opencode-sync-agents.sh (Taskfile.yml) ihn nach
  // ~/.config/opencode/opencode.jsonc. Eine zweite Definition an dieser Stelle
  // wuerde den gesyncten Wert projekt-lokal ueberschreiben und unbemerkt
  // abdriften — genau so zeigte er auf den Bonsai-Port 8093 statt auf 8091
  // (T002159).
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {}
    }
  },
  "mcp": {

    "bge-mcp": {

      "type": "remote",

      "url": "http://localhost:13005/mcp",

      "headers": {"Authorization":"Bearer {env:BGE_MCP_TOKEN}"},

      "enabled": true

    },

    "brain-mcp-node": {

      "type": "local",

      "command": ["node","scripts/brain-mcp-node/server.mjs"],

      "environment": {"BRAIN_WIKI_DIR":"~/brain/wiki"},

      "enabled": false

    },

    "codebase-memory-mcp": {

      "type": "local",

      "command": ["codebase-memory-mcp"],

      "enabled": false

    },

    "factory-mcp-node": {

      "type": "remote",

      "url": "http://localhost:13003/mcp",

      "enabled": true

    },

    "mcp-kubernetes": {

      "type": "remote",

      "url": "http://localhost:18080/mcp",

      "enabled": true

    },

    "mcp-postgres": {

      "type": "remote",

      "url": "http://localhost:13001/mcp",

      "enabled": true

    },

    "mcp-task-runner": {

      "type": "local",

      "command": ["node","scripts/mcp-task-runner/server.mjs","--otel-endpoint","localhost:4317","--taskfile","Taskfile.yml"],

      "enabled": true

    },

    "playwright": {

      "type": "local",

      "command": ["npx","-y","@playwright/mcp@latest"],

      "enabled": false

    },

    "ticket-mcp-node": {

      "type": "local",

      "command": ["node","scripts/ticket-mcp-node/server.mjs"],

      "enabled": true

    }

  }
}
