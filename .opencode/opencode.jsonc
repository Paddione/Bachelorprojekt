{
  "$schema": "https://opencode.ai/config.json",
  // Qwen 3.8 27B IQ3_XXS als Standard — das Loadout qwen38-220k auf Port 8094
  // (Backend llamacpp-qwen38). Es ist der textbasierte Primary mit 114.688
  // Kontext. Fuer Vision muss gemma12-primary bzw. gemma26-vision explizit
  // gewaehlt werden.
  //
  // WARUM DER DEFAULT DAS GEWUENSCHTE LOADOUT SEIN MUSS: Alle chat-gpu-Loadouts teilen
  // eine exclusiveGroup, es laeuft also immer nur eines. Solange der Default auf
  // ein anderes Loadout zeigte als das, mit dem gearbeitet wird, stoppte jede
  // neue opencode-Session zuerst das laufende, um den Default zu starten. Als
  // ein anderes Default-Loadout fordert, wird qwen38-220k gestoppt und der Client
  // meldet "no healthy backend", waehrend stattdessen Gemma geladen wird. Der
  // Default gehoert deshalb auf das Loadout, das tatsaechlich laufen soll.
  //
  // Fallback-Kette bleibt: bei Ausfall des lokalen Servers greifen die
  // deepseek-*-Agenten (direkte API, nicht ueber den Proxy).
  "model": "llamacpp-local/qwen38-220k",
  "permission": {
    "read": "allow",
    "edit": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "bash": "allow",
    "task": "allow",
    "external_directory": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "lsp": "allow",
    "doom_loop": "deny",
    "skill": {
      "*": "allow",
      // ── Claude Code stubs (opencode has native equivalents) ──────────
      "dev-flow-plan": "deny",
      "dev-flow-execute": "deny",
      "dev-flow-chore": "deny",
      "dev-flow-e2e": "deny",
      // ── Generic meta / skill discovery ───────────────────────────────
      "agent-orchestration": "deny",
      "project-overview": "deny",
      "find-skills": "deny",
      "skill-creator": "deny",
      "codebase-memory": "deny",
      // ── Domain specialists (dispatched via agent routing, not skills) ─
      "database-specialist": "deny",
      "incident-response": "deny",
      "infra-ops": "deny",
      "operations-management": "deny",
      "security-specialist": "deny",
      "website-specialist": "deny",
      // ── UI/design (not primary workflow) ─────────────────────────────
      "ui-ux-pro-max": "deny",
      "references": "deny",
      // ── market-cli installed (not project-relevant, avoid context bloat) ─
      "lavish": "deny"
    }
  },
  "lsp": true,
  // Der Provider "llamacpp-mtp" wird bewusst NICHT hier definiert, sondern
  // ausschliesslich in .opencode/agent-models.jsonc — von dort synct
  // scripts/opencode-sync-agents.sh (Taskfile.yml) ihn nach
  // ~/.config/opencode/opencode.jsonc. Eine zweite Definition an dieser Stelle
  // wuerde den gesyncten Wert projekt-lokal ueberschreiben und unbemerkt
  // abdriften — genau so zeigte er auf den Bonsai-Port 8093 statt auf 8091
  // (T002159).
  "provider": {
    "lmstudio": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LM Studio (local)",
      "options": {
        "baseURL": "http://127.0.0.1:1234/v1"
      },
      "models": {}
    }
  },
  "mcp": {

    "bge-mcp": {

      "type": "remote",

      "url": "http://localhost:13005/mcp",

      "headers": {"Authorization":"Bearer {env:BGE_MCP_TOKEN}"},

      "enabled": true

    },

    "brain-mcp": {

      "type": "local",

      "command": ["python3","/home/patrick/Bachelorprojekt/scripts/brain-mcp-server.py"],

      "environment": {"BRAIN_WIKI_DIR":"~/brain/wiki"},

      "enabled": true

    },

    "codebase-memory-mcp": {

      "type": "local",

      "command": ["/home/patrick/.local/bin/codebase-memory-mcp"],

      "enabled": true

    },

    "docfork": {

      "type": "local",

      "command": ["npx","-y","docfork"],

      "enabled": false

    },

    "factory-mcp": {

      "type": "remote",

      "url": "http://localhost:13003/mcp",

      "enabled": true

    },

    "github-mcp": {

      "type": "local",

      "command": ["npx","-y","@modelcontextprotocol/server-github"],

      "environment": {"GITHUB_TOKEN":"{env:GITHUB_TOKEN}"},

      "enabled": false

    },

    "mcp-kubernetes": {

      "type": "remote",

      "url": "http://localhost:18080/mcp",

      "enabled": true

    },

    "mcp-postgres": {

      "type": "remote",

      "url": "http://localhost:13001/mcp",

      "enabled": true

    },

    "mcp-task-runner": {

      "type": "local",

      "command": ["mcp-task-runner","--otel-endpoint","localhost:4317","--taskfile","/home/patrick/Bachelorprojekt/Taskfile.yml"],

      "enabled": true

    },

    "playwright": {

      "type": "local",

      "command": ["npx","-y","@playwright/mcp@latest"],

      "enabled": false

    },

    "sequential-thinking": {

      "type": "local",

      "command": ["npx","-y","@modelcontextprotocol/server-sequential-thinking"],

      "enabled": false

    },

    "ticket-mcp": {

      "type": "local",

      "command": ["ticket-mcp-go"],

      "enabled": true

    },

    "webresearch": {

      "type": "local",

      "command": ["npx","-y","@mzxrai/mcp-webresearch@latest"],

      "enabled": false

    }

  }
}
