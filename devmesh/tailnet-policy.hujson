// devmesh/tailnet-policy.hujson — Spiegel der Live-Policy des Tailnets (T900116, T016528)
// Stand: API-Export GET /api/v2/tailnet/-/acl vom 2026-10-12.
// Aenderungen: in der Admin-Konsole (Access controls) oder per API
// (POST /api/v2/tailnet/-/acl mit If-Match-ETag, vorher /acl/validate), danach diese
// Datei nachziehen. Die Datei wird nicht automatisch eingespielt.
// devmesh-Server tragen tag:gpu-server (devmesh/inventory.yaml); Clients sind
// Geraete unter dem Benutzerkonto ohne Tag. grants erlauben allen Verkehr im Tailnet.
// Guard: tests/py/spec/native_ported/spec/local-dev-mesh/test_tailnet_policy.py.
// Format-Regel fuer den Guard: Kommentare nur als ganze Zeilen.
{
	"grants": [{"src": ["*"], "dst": ["*"], "ip": ["*"]}],
	"ssh": [{
		"action": "check",
		"src":    ["autogroup:member"],
		"dst":    ["autogroup:self"],
		"users":  ["autogroup:nonroot", "root"],
	}, {
		"action": "accept",
		"src":    ["autogroup:member"],
		"dst":    ["autogroup:self"],
		"users":  ["autogroup:nonroot"],
	}, {
		"action": "check",
		"src":    ["autogroup:member"],
		"dst":    ["tag:gpu-server"],
		"users":  ["root"],
	}, {
		"action": "accept",
		"src":    ["tag:orchestrator"],
		"dst":    ["tag:gpu-server"],
		"users":  ["patrick", "ubuntu"],
	}, {
		"action": "accept",
		"src":    ["tag:orchestrator"],
		"dst":    ["tag:home-dns"],
		"users":  ["patrick"],
	}],
	"nodeAttrs": [{"target": ["autogroup:member"], "attr": ["funnel"]}],
	"tagOwners": {
		"tag:gpu-server":   ["autogroup:admin"],
		"tag:orchestrator": ["autogroup:admin"],
		"tag:k8s-operator": ["autogroup:admin"],
		"tag:k8s":          ["autogroup:admin"],
		"tag:home-dns":     ["autogroup:admin"],
		// LAN-/Tailnet-DNS (AdGuard in devmesh), Geraet vom Tailscale-Operator (T016515).
		"tag:lan-dns": ["autogroup:admin", "tag:k8s-operator"],
	},
	// Redundante Subnet-Route ins Heimnetz: Router gpu-cluster, gpu-cluster2 (inventory subnet_routes, T016515).
	"autoApprovers": {
		"routes": {
			"10.0.0.0/24": ["tag:gpu-server"],
		},
	},
}
