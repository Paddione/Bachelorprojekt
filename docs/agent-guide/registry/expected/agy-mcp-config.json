{
  "mcpServers": {
    "bge-mcp": {
      "serverUrl": "http://localhost:13005/mcp"
    },
    "codebase-memory-mcp": {
      "command": "npx",
      "args": [
        "-y",
        "codebase-memory-mcp@0.10.8"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp@4.1.1"
      ]
    },
    "mcp-kubernetes": {
      "serverUrl": "http://localhost:18080/mcp"
    },
    "mcp-postgres": {
      "serverUrl": "http://localhost:13001/mcp"
    },
    "mcp-task-runner": {
      "command": "mcp-task-runner",
      "args": [
        "--otel-endpoint",
        "localhost:4317",
        "--taskfile",
        "/home/patrick/Bachelorprojekt/Taskfile.yml"
      ]
    },
    "ticket-mcp": {
      "command": "node",
      "args": ["/home/patrick/Bachelorprojekt/scripts/ticket-mcp-node/server.mjs"]
    }
  }
}
