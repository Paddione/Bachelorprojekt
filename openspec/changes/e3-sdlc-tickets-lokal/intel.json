  "risks": [
    {
      "id": "R1",
      "risk": "post-merge.yml entkernen ohne nachgewiesenen Poller laesst Tickets nach dem Merge still offen",
      "mitigation": "Reihenfolge im Plan bindend: p3 weist den Poller nach, bevor die CI-Schritte fallen"
    },
    {
      "id": "R2",
      "risk": "Cursor vor dem Schreiben vorruecken verliert genau die Ereignisse, die die DoD schuetzt",
      "mitigation": "Cursor-nach-Schreiben plus idempotente Writes; eigener BATS-Fall in p5"
    },
    {
      "id": "R3",
      "risk": "Namespace-Umbiegung in ticket.sh:69-75 macht jeden Ticket-Befehl nach dem Cutover unbrauchbar",
      "mitigation": "D7 korrigiert sie in p2, vor der Default-Umstellung"
    },
    {
      "id": "R4",
      "risk": "Zwei provider_config-Instanzen laufen auseinander",
      "mitigation": "bewusst getragen (D1); Zustaendigkeit im Runbook festgehalten"
    },
    {
      "id": "R5",
      "risk": "Docker-Daemon lief zum Planungszeitpunkt nicht — der lokale Cluster konnte nicht verifiziert werden",
      "mitigation": "p1 beginnt mit einem Erreichbarkeits-Check des lokalen Clusters, bevor irgendetwas migriert wird"
    },
    {
      "id": "R6",
      "risk": "projects-db.ts schreibt aus dem Prod-Build nach tickets.tickets (41 Projekte) — der geplante Freeze haette das Kundenportal gebrochen",
      "mitigation": "Freeze aus E3 herausgenommen und nach T002722 verschoben; migrate-tickets.sh freeze verlangt SDLC_FREEZE_CONFIRM"
    }
  ],
