{
  "name": "bachelorprojekt-scripts",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:track-pr": "node --test scripts/track-pr.test.mjs",
    "test:agent-guide": "node --test scripts/agent-guide/*.test.mjs",
    "test:code-quality": "node --test scripts/code-quality/*.test.mjs scripts/code-quality/gates/*.test.mjs",
    "test:migrate-factory": "node --test scripts/migrate-factory.test.mjs"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@astrojs/language-server": "^2.17.2",
    "@axe-core/playwright": "^4.13.0",
    "@hono/node-server": "^2.1.5",
    "@mermaid-js/mermaid-cli": "^12.0.0",
    "@playwright/test": "^1.64.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "@types/pino": "^7.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "bash-language-server": "^5.8.1",
    "cheerio": "^1.2.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.13",
    "madge": "^8.0.0",
    "marked": "^18.1.1",
    "openai": "^7.33.0",
    "svelte-language-server": "^0.18.4",
    "tsx": "^4.23.15",
    "typescript": "^5.0.0",
    "typescript-language-server": "^6.0.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.4",
    "yaml": "^2.9.1",
    "yaml-language-server": "^1.25.0"
  },
  "allowScripts": {
    "puppeteer@25.12.0": true,
    "esbuild@0.28.2": true
  }
}
