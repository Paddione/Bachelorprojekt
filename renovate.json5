{
  // Renovate self-hosted dependency update bot configuration.
  // Spec: docs/superpowers/specs/2026-06-17-t000898-design.md
  // Plan: docs/superpowers/plans/2026-06-17-t000898.md
  // Schema: https://docs.renovatebot.com/renovate-schema.json
  //
  // Executed weekly by .github/workflows/renovate.yml (self-hosted GitHub Action).
  // Auth: a per-run GitHub App installation token, minted from the secrets
  // RENOVATE_APP_ID + RENOVATE_APP_PRIVATE_KEY (T002161 — an installation token
  // has a 1h TTL and cannot be stored statically). The workflow also passes
  // RENOVATE_REPOSITORIES, without which Renovate runs green but processes no
  // repository at all (T002165).

  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  // Base recommended configuration from Renovate.
  "extends": ["config:recommended"],

  // Weekly schedule: Monday morning (Berlin time).
  "schedule": ["before 9am on monday"],
  "timezone": "Europe/Berlin",

  // Require releases to be at least 3 days old before proposing an update.
  // This prevents same-day merges of potentially broken releases.
  "minimumReleaseAge": "3 days",

  // Paths that Renovate should never touch.
  "ignorePaths": [
    "**/node_modules/**",
    "art-library/**",
    "scripts/coaching/**",
    "scripts/knowledge/**",
    "tests/e2e/**",
    "tests/unit/**"
  ],

  // Rate limiting to prevent PR floods on first run.
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,

  // Enable the Dependency Dashboard issue for visibility.
  "dependencyDashboard": true,

  // Conventional Commits for CI gate compliance (Required Check).
  // Renovate will use chore(deps): / fix(deps): prefixes.
  "semanticCommits": "enabled",

  // PR label (T002161). auto-enable-automerge.yml skips PRs carrying this label,
  // so the blanket "--auto on every non-draft PR" no longer overrides the staged
  // automerge policy in packageRules below. Label-based rather than bot-name-based:
  // the App slug depends on the freely chosen App name.
  "labels": ["dependencies"],

  // Renovate sets the GitHub auto-merge flag itself — but only on PRs its own
  // packageRules release for automerge (patch + devDependencies). major, prod
  // minor and kubernetes major stay open as review PRs.
  "platformAutomerge": true,

  "packageRules": [
    // ── npm (pnpm workspaces) ─────────────────────────────────────────────

    // npm minor/patch: grouped per package directory, no automerge.
    // (patch gets automerge below via a more specific rule.)
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm minor/patch ({{packageFileDir}})",
      "automerge": false
    },

    // npm patch (all dep types): automerge.
    // Overrides the group rule above for patch-only updates.
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },

    // npm devDependencies minor + patch: automerge.
    // Non-production code — safe to automerge non-major.
    {
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },

    // npm major: never automerge, separate group for review.
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"],
      "groupName": "npm major updates",
      "automerge": false
    },

    // ── Kubernetes / Docker images ─────────────────────────────────────────
    // Docker base images are managed via the kubernetes manager (reads image
    // references in k3d/prod manifests).

    // LiveKit image family.
    // matchPackageNames with slash-wrapped regex — matchPackagePatterns is
    // deprecated upstream ("Config needs migrating", T002165).
    {
      "matchManagers": ["kubernetes"],
      "matchPackageNames": ["/^livekit//"],
      "groupName": "livekit images"
    },

    // Nextcloud image family.
    {
      "matchManagers": ["kubernetes"],
      "matchPackageNames": ["/^nextcloud/", "/^ghcr.io/nextcloud/"],
      "groupName": "nextcloud images"
    },

    // No Keycloak rule: the platform migrated from Keycloak to Pocket ID, and no
    // quay.io/keycloak image remains in any manifest (T002165). Pocket ID gets no
    // group of its own — it is a single image (ghcr.io/pocket-id/pocket-id), and
    // groups exist to bundle image *families*.

    // Kubernetes major: never automerge.
    {
      "matchManagers": ["kubernetes"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },

    // ── GitHub Actions ─────────────────────────────────────────────────────

    // GitHub Actions: pinDigests (SHA-pin) stays enabled, grouped together.
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions digest pins",
      "pinDigests": true
    },

    // GitHub Actions major: never automerge.
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["major"],
      "automerge": false
    },

    // ── Disabled packages ──────────────────────────────────────────────────

    // Own ghcr.io images are rebuilt on release via CI, not bumped by Renovate.
    {
      "matchPackageNames": ["/^ghcr.io/paddione//"],
      "enabled": false
    },

    // faster-whisper-server is manually pinned.
    {
      "matchPackageNames": ["fedirz/faster-whisper-server"],
      "enabled": false
    }
  ],

  // Kubernetes manager: scan image references in k3d and prod manifests.
  // managerFilePatterns replaces the deprecated fileMatch (T002170) — it was the
  // remaining item behind Renovate's "Config needs migrating" warning after
  // T002165 handled matchPackagePatterns. Regexes are slash-wrapped, same as the
  // matchPackageNames migration.
  //
  // NOTE: the kubernetes manager ships NO default patterns — without these it
  // matches nothing at all and every k8s image silently stops being updated
  // (Vaultwarden, Pocket ID, postgres, …). Verify against the Dependency
  // Dashboard after changing them, not just against a green workflow run.
  "kubernetes": {
    "managerFilePatterns": [
      "/^k3d/.+\\.yaml$/",
      "/^prod/.+\\.yaml$/",
      "/^prod-mentolder/.+\\.yaml$/",
      "/^prod-korczewski/.+\\.yaml$/",
      "/^prod-fleet/.+\\.yaml$/"
    ],
    // pinDigests: automatically update @sha256 digests on every update.
    "pinDigests": true
  }
}
