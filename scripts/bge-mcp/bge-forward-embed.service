# scripts/bge-mcp/bge-forward-embed.service
# Port-Forward 127.0.0.1:8081 -> svc/llm-gateway-embed (ClusterIP :8081), ns workspace.
#
# WARUM EINE EIGENE UNIT (T002604)
# Bis hierher startete bge-mcp.service beide Forwards als Hintergrundjobs im
# eigenen `bash -c` und machte dann `exec node server.mjs`. systemd sah damit
# ausschliesslich den Node-Prozess: sterben die Forwards — was bei jedem Neustart
# eines bge-Pods passiert, weil `kubectl port-forward` an den Pod gebunden ist —
# meldet die Unit weiter `active`, waehrend jeder Tool-Call mit "fetch failed"
# scheitert. Genau dieser Zustand lag am 2026-08-03 vor: Unit active, beide
# Forwards seit Stunden tot, bge_embed und bge_rerank unbenutzbar.
#
# Als eigene Unit greift Restart=always auf den Prozess, der tatsaechlich
# ausfaellt. Der Shim haengt per Requires= daran und faellt mit ihm.
#
# Symlink zum Aktivieren:
#   ln -sf $PWD/scripts/bge-mcp/bge-forward-embed.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now bge-forward-embed

[Unit]
Description=Port-forward llm-gateway-embed (127.0.0.1:8081)
After=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/kubectl --context fleet port-forward -n workspace svc/llm-gateway-embed 8081:8081
# Kein Ratenlimit-Abbruch: bei einem Rollout kann der Forward mehrfach in kurzer
# Folge sterben. Ohne StartLimitIntervalSec=0 gaebe systemd nach 5 Versuchen auf
# und liesse genau den Zustand zurueck, den diese Unit verhindern soll.
Restart=always
RestartSec=3
StartLimitIntervalSec=0

[Install]
WantedBy=default.target
