#cloud-config
# Hetzner k3s SERVER (control-plane) bootstrap — fleet auf gekko, auf gekko (T016529, D1/D2)
# Rendered by: scripts/hetzner/render-cloud-init.sh --template scripts/hetzner/cloud-init-server.yaml.tmpl
#
# Alle drei gekko-Nodes (gekko-hetzner-2/3/4) sind Server mit embedded etcd (D2).
# First CP node (cluster-init):   omit --k3s-url (or pass empty) → triggers --cluster-init
# Additional CP nodes (HA join):  --k3s-url https://<first-cp-private-ip>:6443
#
# Netz (D1): node-ip aus dem privaten Hetzner-Netz (192.168.200.x), Flannel
# ueber das private Interface. Admin/kubectl ueber Tailscale
# (eigener fleet-Tag); Key-Ablauf fuer tag:fleet in der Tailscale-Admin-Konsole
# deaktivieren. Oeffentlich sind nur 80/443 erreichbar; Cluster-Ports nur aus
# dem privaten Netz bzw. ueber das Tailnet.
#
# Variables: NODE_NAME, NODE_IP (privat), NODE_PUBLIC_IP, PRIVATE_IFACE,
#            PRIVATE_SUBNET, TAILNET_NAME, TAILNET_IP, TAILSCALE_AUTH_KEY,
#            K3S_VERSION, K3S_URL, K3S_TOKEN, SSH_PUBLIC_KEY

package_update: true
package_upgrade: false
package_reboot_if_required: false

packages:
  - ufw
  - curl
  - jq
  - apt-transport-https

hostname: ${NODE_NAME}
manage_etc_hosts: true

ssh_authorized_keys:
  - ${SSH_PUBLIC_KEY}

write_files:
  # Tailscale-Auth-Key ueber Datei uebergeben (nicht in der Prozessliste).
  - path: /etc/tailscale/auth-key
    permissions: "0600"
    content: ${TAILSCALE_AUTH_KEY}

  # k3s server config — Flannel ueber das private Interface
  # (direkt, ohne Tunnel); TLS-SANs: private IP, oeffentliche IP, Tailnet-Name/-IP.
  - path: /etc/rancher/k3s/config.yaml
    content: |
      node-name: "${NODE_NAME}"
      node-ip: "${NODE_IP}"
      flannel-iface: "${PRIVATE_IFACE}"
      tls-san:
        - "${NODE_IP}"
        - "${NODE_PUBLIC_IP}"
        - "${TAILNET_NAME}"
        - "${TAILNET_IP}"

runcmd:
  # Tailscale installieren und mit fleet-Tag ins Tailnet bringen (Admin/kubectl).
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key="file:/etc/tailscale/auth-key" --hostname="${NODE_NAME}" --advertise-tags=tag:fleet --ssh --accept-routes=false

  # Firewall — default deny; oeffentlich nur 80/443. Cluster- und Admin-Ports
  # nur aus dem privaten Netz; SSH/API zusaetzlich ueber das Tailnet.
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 80/tcp comment 'HTTP'
  - ufw allow 443/tcp comment 'HTTPS'
  - ufw allow from ${PRIVATE_SUBNET} to any port 22 proto tcp comment 'SSH privat'
  - ufw allow from ${PRIVATE_SUBNET} to any port 6443 proto tcp comment 'k3s API privat'
  - ufw allow from ${PRIVATE_SUBNET} to any port 10250 proto tcp comment 'kubelet privat'
  - ufw allow from ${PRIVATE_SUBNET} to any port 8472 proto udp comment 'Flannel VXLAN privat'
  - ufw allow from ${PRIVATE_SUBNET} to any port 2379:2380 proto tcp comment 'etcd client+peer privat'
  - ufw allow in on tailscale0 to any port 22 proto tcp comment 'SSH Tailnet'
  - ufw allow in on tailscale0 to any port 6443 proto tcp comment 'k3s API Tailnet'
  - ufw --force enable

  # k3s server install — cluster-init when K3S_URL is empty, join when set
  - |
    K3S_URL="${K3S_URL}"
    if [ -n "$K3S_URL" ]; then
      INSTALL_K3S_VERSION="${K3S_VERSION}" K3S_URL="$K3S_URL" K3S_TOKEN="${K3S_TOKEN}" \
        curl -sfL https://get.k3s.io | sh -s - server
    else
      INSTALL_K3S_VERSION="${K3S_VERSION}" K3S_TOKEN="${K3S_TOKEN}" \
        curl -sfL https://get.k3s.io | sh -s - server --cluster-init
    fi

final_message: |
  k3s server ${NODE_NAME} (${NODE_IP}, tailnet ${TAILNET_NAME}) bootstrapped.
