#cloud-config
# Hetzner AGENT (worker) bootstrap — fleet auf gekko, auf gekko (T016529, D1)
# Rendered by: scripts/hetzner/render-cloud-init.sh
#
# Der fleet-Cluster besteht aus drei Servern mit embedded etcd (D2); dieses
# Agent-Template bleibt fuer einen spaeteren Worker-Join bestehen. Netz wie
# bei den Servern: node-ip aus dem privaten Netz (192.168.200.x), Flannel
# ueber das private Interface, Admin ueber Tailscale
# (fleet-Tag, Key-Ablauf in der Admin-Konsole deaktiviert), oeffentlich
# nur 80/443.
#
# Variables: NODE_NAME, NODE_IP (privat), NODE_PUBLIC_IP, PRIVATE_IFACE,
#            PRIVATE_SUBNET, TAILNET_NAME, TAILNET_IP, TAILSCALE_AUTH_KEY,
#            K3S_VERSION, K3S_URL, K3S_TOKEN, SSH_PUBLIC_KEY

package_update: true
package_upgrade: false
package_reboot_if_required: false

packages:
  - ufw
  - curl
  - jq
  - apt-transport-https

hostname: ${NODE_NAME}
manage_etc_hosts: true

ssh_authorized_keys:
  - ${SSH_PUBLIC_KEY}

write_files:
  # Tailscale-Auth-Key ueber Datei uebergeben (nicht in der Prozessliste).
  - path: /etc/tailscale/auth-key
    permissions: "0600"
    content: ${TAILSCALE_AUTH_KEY}

  # k3s agent config — private Node-IP, Flannel ueber das private Interface.
  - path: /etc/rancher/k3s/config.yaml
    content: |
      node-name: "${NODE_NAME}"
      node-ip: "${NODE_IP}"
      flannel-iface: "${PRIVATE_IFACE}"
      node-label:
        - "node-role.kubernetes.io/worker=true"

runcmd:
  # Tailscale installieren und mit fleet-Tag ins Tailnet bringen (Admin).
  - curl -fsSL https://tailscale.com/install.sh | sh
  - tailscale up --auth-key="file:/etc/tailscale/auth-key" --hostname="${NODE_NAME}" --advertise-tags=tag:fleet --ssh --accept-routes=false

  # Firewall — default deny; oeffentlich nur 80/443, Rest privat/Tailnet.
  - ufw default deny incoming
  - ufw default allow outgoing
  - ufw allow 80/tcp comment 'HTTP'
  - ufw allow 443/tcp comment 'HTTPS'
  - ufw allow from ${PRIVATE_SUBNET} to any port 22 proto tcp comment 'SSH privat'
  - ufw allow from ${PRIVATE_SUBNET} to any port 10250 proto tcp comment 'kubelet privat'
  - ufw allow from ${PRIVATE_SUBNET} to any port 8472 proto udp comment 'Flannel VXLAN privat'
  - ufw allow in on tailscale0 to any port 22 proto tcp comment 'SSH Tailnet'
  - ufw --force enable

  # k3s agent install — pinned version, joins cluster via private CP address
  - >-
    INSTALL_K3S_VERSION="${K3S_VERSION}"
    K3S_URL="${K3S_URL}"
    K3S_TOKEN="${K3S_TOKEN}"
    curl -sfL https://get.k3s.io | sh -

final_message: |
  Agent node ${NODE_NAME} (${NODE_IP}) bootstrapped. k3s agent registered against ${K3S_URL}.
