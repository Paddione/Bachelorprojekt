# scripts/llm/pk-tablet/llama-server@.service — Template-Unit auf PK-Tablet.
# Eine Instanz je aktivem Loadout: llama-server@<slug>.service. Ein- und
# ausgeschaltet wird sie von scripts/llm/pk-tablet/apply.sh.
[Unit]
Description=llama-server Loadout %i
After=network-online.target
Wants=network-online.target

[Service]
User=llama
Group=llama
# /dev/dri gehoert render/video — ohne die Gruppen faellt Vulkan still auf CPU zurueck.
SupplementaryGroups=render video
Environment=LD_LIBRARY_PATH=/opt/llama/current
ExecStart=/opt/llama/run-loadout.sh %i
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
