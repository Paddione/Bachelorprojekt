# systemd-User-Unit: Qwen3.8-27B GSQ-RCO IQ2_S-mtp auf der RTX 5070 Ti allein, llama.cpp :1919.
# Loest glimmer.service (Muse Glimmer 30B) und FreeToken ab; alle Konsumenten sprechen weiter :1919 an.
#
# Warum dieses Modell: Orchestrierungs-Benchmark 2026-09-26 (scripts/llm/measurements/
# 2026-09-26-orchestration-4b.md): Qwen3.8 GSQ-RCO 15/15 (IQ3_XXS) bzw. 13/15 (IQ2_S), Glimmer 9/15,
# FreeToken Qwen3.6-35B-A3B 11/15.
#
# Modell:
#   hf download ISTA-DASLab/Qwen3.8-27B-GSQ-RCO-GGUF Qwen3.8-27B-GSQ-RCO-IQ2_S-mtp.gguf --local-dir /mnt/f/models/Qwen3.8-27B-GSQ-RCO
#
# Installation (Kopie, KEIN Symlink -- T900376):
#   cp scripts/llm/qwen38-gsq-iq2s.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now qwen38-gsq-iq2s
#
# Gemessen 2026-09-26 (scripts/llm/measurements/2026-09-26-qwen38-gsq-iq2s-mtp.md):
#   196608 Kontext, q4_0-KV, 1 Slot: 15.439 MiB, Decode 71-102 t/s mit MTP n-max 4 (60 ohne),
#   Prefill 1.305 t/s, Prompt bis 186k ohne Spill.
#   n-max 4 ist der beste Kompromiss (n-max 3: 71-96, n-max 5: 63-105).
#   -ub > 512 bringt keinen Prefill-Gewinn und treibt den VRAM in den Spill (15,9 GB).
#   -cram 12288: ein verdraengter Orchestrator-Slot (51k Token) kehrt in 2,9 s statt 48 s zurueck.
#
# Obergrenze: ab ~15,9 GB lagert CUDA unter WSL still in den Systemspeicher aus; llama-server meldet
# trotzdem Erfolg, der Prefill faellt auf ~1 t/s. Kein zweites CUDA-Programm auf der 5070 Ti.
[Unit]
Description=llama-server Qwen3.8-27B GSQ-RCO IQ2_S-mtp (RTX 5070 Ti, 196k ctx) auf :1919
After=network.target

[Service]
Type=simple
Environment=CUDA_DEVICE_ORDER=PCI_BUS_ID
Environment=CUDA_VISIBLE_DEVICES=GPU-7dc4bd81-3a8d-c414-1751-f74dee8882f4
ExecStart=%h/opt/llama-current/bin/llama-server \
  -m /mnt/f/models/Qwen3.8-27B-GSQ-RCO/Qwen3.8-27B-GSQ-RCO-IQ2_S-mtp.gguf \
  --alias Qwen3.8-27B-gsq-iq2s \
  -c 196608 -np 1 -ub 512 \
  -fit off -ngl 999 \
  -fa on -ctk q4_0 -ctv q4_0 \
  --spec-type draft-mtp --spec-draft-n-max 4 \
  -cram 12288 \
  --jinja \
  --host 0.0.0.0 --port 1919
Restart=on-failure
RestartSec=10
TimeoutStartSec=300

[Install]
WantedBy=default.target
