# Status: Toter Zustand auf diesem Host. WSL-Exit 2026-09-03: Docker Desktop deinstalliert,
# kein Linux-Laufzeitkontext mehr — die Unit bindet WSL-Pfade (/home/patrick/...).
# Pendant-Lücke: `scripts/mcp-gateway/start-windows.ps1` deckt nur bge-mcp und die
# mcp-gateway-Port-Forwards ab, diese Unit NICHT. Windows-Pendant = eigenes Ticket.
# Siehe Runbook `docs/runbooks/remote-docker-context.md` → "Pendant-Lücke".
# scripts/mcp-cors-proxy/mcp-cors-proxy.service
# mcp-cors-proxy — systemd USER service. Guarded CORS-Reverse-Proxy vor
# mcp-kubernetes (127.0.0.1:18082 -> 127.0.0.1:18080). Nutzt den gemeinsamen
# HTTP-Sicherheitsgrenze (mcp-http-security.mjs) fuer Host-/Origin/Token-
# Validierung. Der Browser (llama-Web-UI auf http://localhost:8098) erreicht
# mcp-kubernetes NUR ueber :18082 (canonical endpoint). [T900052]
# Installed/managed via `task agents:mcp-cors-proxy:install` (symlinked into
# ~/.config/systemd/user/).
[Unit]
Description=MCP CORS reverse proxy (mcp-kubernetes :18082 -> :18080)
After=network-online.target
Wants=mcp-gateway.service

[Service]
Type=simple
WorkingDirectory=/home/patrick/Bachelorprojekt
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=LISTEN_PORT=18082
Environment=UPSTREAM=http://127.0.0.1:18080
EnvironmentFile=-/home/patrick/.config/mcp-cors-proxy/server.env
ExecStart=/usr/bin/node /home/patrick/Bachelorprojekt/scripts/mcp-cors-proxy/proxy.mjs
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
