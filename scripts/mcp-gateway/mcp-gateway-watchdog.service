# scripts/mcp-gateway/mcp-gateway-watchdog.service
# T002543 — Watchdog for mcp-gateway.service tunnel liveness.
#
# Der Watchdog fuehrt probe.sh aus (echter MCP-initialize, kein TCP-Connect).
# Scheitert der Probe, wird die betroffene Kette neu gestartet — es sei denn,
# der Ziel-Pod ist tot (dann hilft kein Tunnel-Neustart) oder der letzte
# Restart liegt weniger als 5 Minuten zurück.
#
# T006996: Die Logik (Rate-Limit, Probe, Pod-Tod-Check, Restart) lebt jetzt in
# watchdog-check.sh. Die fruehere Inline-ExecStartPre-Zeile war systemd-Syntax-
# invalide ("/usr/bin/test: extra argument '&&'") — der Rate-Limit-Vorcheck
# lief nie, und die dokumentierte Restart-Logik war nicht implementiert.
#
# Installiert via: systemctl --user enable --now mcp-gateway-watchdog.timer
[Unit]
Description=MCP Gateway Watchdog — Tunnel-Liveness Probe
Documentation=file:///home/patrick/Bachelorprojekt/.claude/skills/references/mcp-tool-guide.md
After=mcp-gateway.service

[Service]
Type=oneshot
WorkingDirectory=/home/patrick/Bachelorprojekt
ExecStart=/home/patrick/Bachelorprojekt/scripts/mcp-gateway/watchdog-check.sh
