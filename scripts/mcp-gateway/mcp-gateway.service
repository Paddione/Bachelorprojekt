# Status: Toter Zustand. WSL-Exit 2026-09-03: Docker Desktop deinstalliert, kein lokaler Dev-Cluster mehr.
# Nachfolger: Windows-Skript `scripts/mcp-gateway/start-windows.ps1`
# (startet `task mcp:autostart:register` → Scheduled Task `PK-MCP-Gateway`).
# scripts/mcp-gateway/mcp-gateway.service
# mcp-gateway — systemd USER service. Long-running `kubectl port-forward` to
# svc/dev-pod (fleet cluster, workspace-dev ns) [T900107], exposing
# mcp-kubernetes (127.0.0.1:18080) and mcp-postgres (127.0.0.1:13001) —
# port 13000 (playwright) is gone with the monolith: playwright stayed a local
# stdio server. 13002 (github) and 18235 (llm-proxy) come from the same service.
# exposed ports but have no MCP client wired to them yet.
# Installed/managed via `task agents:mcp-gateway:install` (symlinked into
# ~/.config/systemd/user/).
[Unit]
Description=MCP gateway port-forward (mcp-kubernetes :18080, mcp-postgres :13001)
Documentation=file:///home/patrick/Bachelorprojekt/.claude/skills/references/mcp-tool-guide.md
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/patrick/Bachelorprojekt
ExecStart=/usr/local/bin/kubectl --context fleet port-forward -n workspace-dev svc/dev-pod 18080:8080 13001:3001 13002:3002 18235:18235
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
