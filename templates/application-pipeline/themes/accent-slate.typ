// templates/application-pipeline/themes/accent-slate.typ
// Theme: Slate — Indigo/Dunkelgrau Akzent, Serifen-Kopfzeilen, eleganter
// Farbpalette: Slate (#2C3E50), Indigo (#6C5CE7), warmer Hintergrund, kontrastreich

// === Farbpalette (Slate/Indigo) ===
#let color-primary = rgb("#2C3E50")
#let color-secondary = rgb("#6C5CE7")
#let color-accent = rgb("#A29BFE")
#let color-bg-light = rgb("#F8F9FD")
#let color-text = rgb("#2D3436")
#let color-muted = rgb("#636E72")
#let color-border = rgb("#DFE6E9")
#let color-white = white
#let color-accent-glow = rgb("#DFE6E9")

// === Typografie ===
#let font-heading = rgb("#2C3E50")
#let font-sans = "Source Sans Pro, Source Sans 3, -apple-system, BlinkMacSystemFont, sans-serif"
#let font-serif = "Lora, Charter, Palatino, 'Palatino Linotype', serif"
#let font-mono = "JetBrains Mono, Fira Code, monospace"

// === Seitenlayout ===
#let margin-top = 1.8cm
#let margin-bottom = 1.8cm
#let margin-left = 2.2cm
#let margin-right = 2.2cm

// === Schriftgrößen (etwas größer/eleganter) ===
#let size-title = 24pt
#let size-section = 14pt
#let size-body = 11pt
#let size-caption = 9pt
#let size-contact = 10pt

// === Formatierungen ===
#let weight-bold = "bold"
#let weight-semibold = "semi-bold"
#let weight-normal = "normal"
#let style-italic = "italic"
#let line-height = 1.5

// === Box-Stil (Evidenz-Abschnitte) — eleganter mit Schatten ===
#let box-fill = rgb("#F8F9FD")
#let box-stroke = rgb("#A29BFE")
#let box-corner-radius = 5pt
#let box-padding = 1em

// === Akzentlinie für Sektionen ===
#let section-line-color = rgb("#6C5CE7")
#let section-line-width = 3pt
