// templates/application-pipeline/themes/default.typ
// Theme: Standard — Royal Blue Akzent, serifenlose Typografie
// Farbpalette: Blau (#1E56A0), Helvetica Neue, professionell/korporat

// === Farbpalette ===
#let color-primary = rgb("#1E56A0")
#let color-secondary = rgb("#4A90D9")
#let color-accent = rgb("#3371AD")
#let color-bg-light = rgb("#F0F4FA")
#let color-text = rgb("#2D3748")
#let color-muted = rgb("#718096")
#let color-border = rgb("#CBD5E0")
#let color-white = white

// === Typografie ===
#let font-heading = rgb("#1E56A0")
#let font-sans = "Inter, Segoe UI, Helvetica Neue, Arial, sans-serif"
#let font-serif = "Georgia, Times New Roman, serif"
#let font-mono = "JetBrains Mono, Fira Code, monospace"

// === Seitenlayout ===
#let margin-top = 1.5cm
#let margin-bottom = 1.5cm
#let margin-left = 2cm
#let margin-right = 2cm

// === Schriftgrößen ===
#let size-title = 22pt
#let size-section = 13pt
#let size-body = 10.5pt
#let size-caption = 8.5pt
#let size-contact = 9.5pt

// === Formatierungen ===
#let weight-bold = "bold"
#let weight-semibold = "semi-bold"
#let weight-normal = "normal"
#let style-italic = "italic"
#let line-height = 1.4

// === Box-Stil (Evidenz-Abschnitte) ===
#let box-fill = rgb("#F0F4FA")
#let box-stroke = rgb("#CBD5E0")
#let box-corner-radius = 3pt
#let box-padding = 0.8em
