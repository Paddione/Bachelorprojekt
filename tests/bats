#!/usr/bin/env bash
# tests/bats — Aufruf-Wrapper um den vendorten BATS-Runner. [T016594]
#
# Zwei Gruende, warum die Taskfiles den Runner nicht mehr direkt aufrufen:
#
# 1) SHEBANG. go-task benutzt den eingebauten mvdan/sh-Interpreter. Fuehrt der
#    eine Datei direkt aus (./pfad), muss er ihren Shebang selbst aufloesen.
#    Unter Windows behandelt er den absoluten POSIX-Pfad /usr/bin/env als
#    relativ zum Arbeitsverzeichnis und bricht mit einem nackten "not found"
#    und Exit 127 ab. Deshalb rufen die Taskfiles Skripte grundsaetzlich ueber
#    den Interpreter auf: `bash tests/bats ...`.
#
# 2) ARBEITSVERZEICHNIS. go-task uebergibt PWD in Windows-Form
#    (C:/Users/...), Git-Bash arbeitet mit /c/Users/... BATS prueft
#    Library-Pfade mit `[[ $path == /* ]]` und lehnt die Windows-Form ab:
#      "Passed library load path is not an absolute path: C:/Users/.../test_helper.bash"
#    Der Wrapper normalisiert das Arbeitsverzeichnis, bevor BATS startet.
#
# Auf Linux/macOS/CI ist beides ein No-op: cygpath existiert dort nicht, und
# PWD traegt ohnehin nie eine Laufwerksangabe. Der Wrapper ist damit
# plattformneutral und aendert das Verhalten ausserhalb von Windows nicht.
#
# Nutzung identisch zum Runner selbst:  bash tests/bats <bats-argumente>

set -euo pipefail

# Skriptverzeichnis VOR dem cd aufloesen — danach waere ein relativer
# BASH_SOURCE-Pfad nicht mehr gueltig.
_here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Windows-Laufwerkspfad in POSIX-Form bringen, sofern wir unter MSYS laufen.
# Die case-Bedingung haelt den Aufruf von cygpath von Nicht-Windows fern.
case "${PWD:-}" in
  [A-Za-z]:[\\/]*)
    if command -v cygpath >/dev/null 2>&1; then
      cd "$(cygpath -u "$PWD")"
    fi
    ;;
esac

# LOCALE. BATS leitet aus jedem Testnamen einen Shell-Funktionsnamen ab. Ohne
# UTF-8-faehige Locale zerlegt Bash Nicht-ASCII byteweise, der abgeleitete Name
# trifft die definierte Funktion nicht mehr, und BATS bricht je Test mit
# "unknown test name" ab -- Exit 1, der Test lief nie. Unter Git-Bash ist LANG
# leer, weshalb 367 Testnamen mit Umlauten, Em-Dash und Pfeilen dort nie liefen;
# auf Linux/CI ist die Locale gesetzt und alles laeuft. [T900065]
#
# Nur setzen, wenn LC_ALL nicht schon explizit vorgegeben ist (bewusste Wahl des
# Aufrufers gewinnt) und C.UTF-8 wirklich existiert -- glibc und MSYS listen es
# als "C.utf8", macOS kennt es oft gar nicht; dort bleibt dies ein No-op.
# C.UTF-8 aendert nur die Zeichenklassifikation, nicht die Sortierreihenfolge,
# die weiterhin byteweise ist wie unter C.
if [ -z "${LC_ALL:-}" ] && locale -a 2>/dev/null | grep -qiE '^C\.utf-?8$'; then
  export LC_ALL=C.UTF-8
fi

# [T900537] SKIP-ZAEHLER IM LAUF. BATS gibt keinen Zusammenfassungs-Satz aus:
# "0 Fehler, 12 skips" war im Terminal nicht von "12 Fehler" unterscheidbar, und
# wer das wissen wollte, musste die Logdatei parsen (genau der Rueckfall, den
# T900537 dokumentiert). Der Zaehler aendert den Exit-Code NICHT — ein Lauf mit
# Skips bleibt gruen, wenn alle Assertions halten. Genau das ist der Punkt: ein
# Skip ist eine Umgebensaussage, kein Fehler, soll aber sichtbar bleiben statt
# im Detail-TAP zu verschwinden.
#
# tee statt exec haelt das Streaming fuer menschliche Aufrufer, PIPESTATUS
# haelt den echten bats-Exit-Code (bei -j schreibt bats den Exit ueber die
# Tap-Ausgabe, nicht als Wrapper-Code).
_bats_summary_log="$(mktemp)"
# shellcheck disable=SC2064  # Wert jetzt einsetzen, nicht spaeter (Variable existiert dann nicht mehr)
trap "rm -f '${_bats_summary_log}'" EXIT

set +e
"$_here/unit/lib/bats-core/bin/bats" "$@" 2>&1 | tee "$_bats_summary_log"
_bats_status="${PIPESTATUS[0]}"
set -e

# "Executed 0 instead of expected N" (fehlendes GNU parallel, siehe
# tests/CLAUDE.md) darf hier NICHT als "0 tests, 0 Fehler" erscheinen — genau
# dieser Fehler sieht sonst aus wie ein gruener Lauf.
_bats_pass="$(grep -c '^ok ' "$_bats_summary_log" || true)"
_bats_fail="$(grep -c '^not ok' "$_bats_summary_log" || true)"
_bats_skip="$(grep -c '^ok .*# skip' "$_bats_summary_log" || true)"
_bats_ran=$(( _bats_pass + _bats_fail ))

# Nur melden, wenn ueberhaupt Tests gelaufen sind. Aufrufe wie --version oder
# --count liefern kein TAP und sollen still bleiben — sonst landet die Zeile im
# $output eines Aufrufers, der seinen echten Output prueft (T900065).
# Auf stderr, nicht auf stdout: `run` in BATS schluckt beides, aber Pipes
# (`bats ... | grep '^tests/spec/.*bats$'`) duerfen keine Diagnose einmisechen.
#
# Bewusst KEINE eigene Warnung fuer "Executed 0 instead of expected N": BATS
# gibt diese Zeile selbst aus, und eine zweite, selbst formulierte Diagnose
# muesste denselben Fall erkennen, den schon der Runner erkennt.
if [ "$_bats_ran" -gt 0 ]; then
  if [ "$_bats_fail" -gt 0 ]; then
    echo "bats summary: ${_bats_ran} Tests — ${_bats_pass} ok, ${_bats_fail} FAILED, ${_bats_skip} skipped" >&2
  else
    echo "bats summary: ${_bats_ran} Tests — 0 failed, ${_bats_skip} skipped (Umgebungs-Assertions, siehe T900537)" >&2
  fi
fi

exit "$_bats_status"
