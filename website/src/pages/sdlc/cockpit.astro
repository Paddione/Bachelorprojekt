---
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getSession, isAdmin } from '../../lib/auth';
import { buildLoginRedirect } from '../../lib/login-redirect';
import CommandBar from '../../components/cockpit/CommandBar.svelte';
import OverviewDashboard from '../../components/cockpit/OverviewDashboard.svelte';
import CockpitRail from '../../components/cockpit/CockpitRail.svelte';
import FactoryFloor from '../../components/sdlc/FactoryFloor.svelte';
import PlanningOffice from '../../components/PlanningOffice.svelte';
import InsightsTab from '../../components/sdlc/factory/InsightsTab.svelte';
import { getFloor } from '../../lib/sdlc/factory-floor.ts';

export const prerender = false;

const BRAND = (): string => process.env.BRAND_ID ?? process.env.BRAND ?? 'mentolder';

const session = await getSession(Astro.request.headers.get('cookie'));
if (!session || !isAdmin(session)) return Astro.redirect(buildLoginRedirect(Astro.url));

const brand = BRAND();
const slotsCap = parseInt(process.env.FACTORY_GLOBAL_CAP ?? '3', 10);

let initial = null;
try { initial = await getFloor(slotsCap); } catch { initial = null; }

type CockpitMode = 'overview' | 'fokus' | 'insights';
type Phase = 'triage' | 'planung' | 'bauen' | 'review' | 'deploy' | 'ship';

const rawMode = Astro.url.searchParams.get('mode') ?? '';
const ALLOWED_MODES: CockpitMode[] = ['overview', 'fokus', 'insights'];
const initialMode: CockpitMode = (ALLOWED_MODES.includes(rawMode as CockpitMode) ? rawMode : 'overview') as CockpitMode;

const rawPhase = Astro.url.searchParams.get('phase') ?? '';
const ALLOWED_PHASES: Phase[] = ['triage', 'planung', 'bauen', 'review', 'deploy', 'ship'];
const initialPhase: Phase = (ALLOWED_PHASES.includes(rawPhase as Phase) ? rawPhase : 'bauen') as Phase;
---

<AdminLayout title="SDLC Cockpit">
  <link rel="stylesheet" href="/cockpit/kit/tokens.css">
  <link rel="stylesheet" href="/cockpit/kit/panel.css">
  <link rel="stylesheet" href="/cockpit/kit/layout.css">
  <script is:inline src="/cockpit/kit/action-policy.js"></script>
  <script is:inline src="/cockpit/kit/panel.js"></script>
  <script is:inline src="/cockpit/kit/layout.js"></script>
  <script is:inline src="/cockpit/kit/adapter.js"></script>

  <div class="cockpit" id="cockpit-root">
    <CommandBar client:load {brand} initialMode={initialMode} />

    <div class="cockpit-body">
      <CockpitRail client:load mode={initialMode} phase={initialPhase} {brand} />

      <main class="cockpit-main" id="cockpit-main">
        {initialMode === 'overview' && (
          <OverviewDashboard client:load />
        )}
        {initialMode === 'fokus' && initialPhase === 'bauen' && (
          <FactoryFloor client:load initial={initial} />
        )}
        {initialMode === 'fokus' && initialPhase === 'planung' && (
          <PlanningOffice client:load {brand} />
        )}
        {initialMode === 'fokus' && initialPhase === 'triage' && (
          <PlanningOffice client:load {brand} />
        )}
        {initialMode === 'fokus' && initialPhase === 'review' && (
          <div class="fokus-phase" data-phase="review">
            <h2 class="fokus-phase__title">Review</h2>
            <p class="fokus-phase__info">Offene PRs und CI-Status werden hier angezeigt (kommendes Feature).</p>
          </div>
        )}
        {initialMode === 'fokus' && initialPhase === 'deploy' && (
          <div class="fokus-phase" data-phase="deploy">
            <h2 class="fokus-phase__title">Deploy</h2>
            <p class="fokus-phase__info">Awaiting-Deploy-Tickets und FluxCD-Status (kommendes Feature).</p>
          </div>
        )}
        {initialMode === 'fokus' && initialPhase === 'ship' && (
          <div class="fokus-phase" data-phase="ship">
            <h2 class="fokus-phase__title">Ship</h2>
            <p class="fokus-phase__info">Ausgelieferte Tickets dieser Woche (kommendes Feature).</p>
          </div>
        )}
        {initialMode === 'insights' && (
          <InsightsTab client:load />
        )}
      </main>
    </div>
  </div>

  <script>
    import { browserLogger } from '$lib/browser-logger';

    // `window.data`, `window.actionPolicy` und `window.cockpitAct` sind in
    // src/env.d.ts global deklariert (SSOT fuer die Kit-Skripte unter
    // /cockpit/kit/). Hier NICHT erneut deklarieren: ein zweites Interface
    // gleichen Namens kollidiert mit der globalen Deklaration (ts(2430)) —
    // ein Fehler, den nur `astro check` sieht, nicht `pnpm lint`/`build`.
    // Das optional chaining bleibt trotz nicht-optionaler Typen: laedt ein
    // Kit-Skript nicht, ist der Wert zur Laufzeit dennoch undefined.

    // Mode switching via CommandBar custom events
    document.addEventListener('cockpit-modechange', ((e: CustomEvent) => {
      const { mode } = e.detail;
      const url = new URL(window.location.href);
      url.searchParams.set('mode', mode);
      if (mode !== 'fokus') url.searchParams.delete('phase');
      history.pushState({}, '', url.toString());
      // Reload the main content area
      window.location.reload();
    }) as EventListener);

    function cockpitAct(action: string, target?: string) {
      try {
        const prompt = window.actionPolicy?.confirmationFor(action, target);
        // `!= null` statt `!== null`: fehlt das Kit-Skript, liefert das optional
        // chaining `undefined` — mit `!== null` liefe der Code dann in einen
        // TypeError auf `prompt.level`, den der catch als "action blocked"
        // meldet. Jede Aktion waere blockiert statt bestaetigungsfrei.
        if (prompt != null) {
          const msg = prompt.level === 'named'
            ? `${action} auf ${prompt.target} ausführen?`
            : `${action} ausführen?`;
          if (!window.confirm(msg)) return;
        }
      } catch (e) {
        browserLogger.error('[cockpit] action blocked: ' + (e as Error).message);
        return;
      }

      window.data?.performAction(action, target ? { target } : {}).then((r) => {
        if (!r.ok && r.error) browserLogger.error('[cockpit] ' + action + ' failed: ' + r.error);
      }).catch((e: unknown) => {
        browserLogger.error({ err: e }, '[cockpit] ' + action + ' error');
      });
    }

    window.cockpitAct = cockpitAct;

    // Stream state indicator
    (function updateHeader() {
      const el = document.getElementById('cockpit-stream-state');
      if (!el || !window.data?.streamState) return;
      const state = window.data.streamState();
      if (state === 'live') {
        el.textContent = '● live';
        el.style.color = 'var(--color-status-ok)';
      } else if (state === 'polling') {
        el.textContent = '● Poll';
        el.style.color = 'var(--color-status-warning)';
      } else {
        el.textContent = '● getrennt';
        el.style.color = 'var(--color-status-error)';
      }
      setTimeout(updateHeader, 5000);
    })();
  </script>
</AdminLayout>

<style>
  .cockpit {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    background: var(--color-dark, #0b111c);
    color: var(--color-fg, #eef1f3);
  }

  .cockpit-body {
    display: flex;
    flex: 1;
    overflow: hidden;
  }

  .cockpit-main {
    flex: 1;
    overflow-y: auto;
    padding: 0;
  }

  .fokus-phase__title {
    font-size: var(--admin-text-lg, 1.1rem);
    color: var(--admin-text, #ccd6f6);
    margin: 0 0 1rem;
    padding: 1.5rem;
    font-family: var(--admin-font-mono, monospace);
  }

  .fokus-phase__info {
    padding: 0 1.5rem;
    color: var(--admin-text-mute, #555);
    font-size: var(--admin-text-sm, 0.85rem);
  }

  .insights-panel {
    padding: 2rem;
  }

  .insights-panel h2 {
    color: var(--admin-text, #ccd6f6);
  }

  .insights-panel p {
    color: var(--admin-text-mute, #555);
  }

  @media (max-width: 767px) {
    .cockpit-body {
      flex-direction: column;
    }

    .cockpit-main {
      padding-bottom: 0;
    }
  }
</style>
