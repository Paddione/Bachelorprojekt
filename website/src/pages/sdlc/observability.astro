---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Service Health Goals & Observability">
  <main class="container mx-auto p-6">
  <h1 class="text-3xl font-bold mb-6">Service Health Goals & Metrics</h1>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    <div class="p-4 bg-gray-800 text-white rounded-lg shadow">
      <h2 class="text-lg font-semibold">Keycloak</h2>
      <p class="text-2xl font-bold text-green-400">99.95%</p>
      <span class="text-sm text-gray-400">Target: 99.90%</span>
    </div>
    <div class="p-4 bg-gray-800 text-white rounded-lg shadow">
      <h2 class="text-lg font-semibold">Nextcloud</h2>
      <p class="text-2xl font-bold text-green-400">99.92%</p>
      <span class="text-sm text-gray-400">Target: 99.90%</span>
    </div>
    <div class="p-4 bg-gray-800 text-white rounded-lg shadow">
      <h2 class="text-lg font-semibold">Vaultwarden</h2>
      <p class="text-2xl font-bold text-green-400">100.0%</p>
      <span class="text-sm text-gray-400">Target: 99.90%</span>
    </div>
  </div>
</main>
</AdminLayout>
